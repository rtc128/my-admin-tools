#!/bin/bash

function confirm()
{
	if [ $ANSWER_YES -eq 1 ]; then
		return 0
	fi
	echo -n "Are you sure you wanna drop all tables (you must type 'yes')? "
	read ANSWER
	[ "$ANSWER" == "yes" ] || return 1
}

function drop_all_schemas()
{
	local LIST_FILE=`mktemp /tmp/my-admin-tools.XXXXXX`
	list_schemas $LIST_FILE || { rm $LIST_FILE; return 1; }
	local S
	for S in `cat $LIST_FILE`; do
		drop_schema $S || { rm $LIST_FILE; return 1; }
	done
	rm $LIST_FILE
}

function drop_schema()
{
	local SCHEMA="$1"
	write_out "   $SCHEMA"
	local LIST_FILE=`mktemp /tmp/my-admin-tools.XXXXXX`
	list_tables "$SCHEMA" $LIST_FILE || { rm $LIST_FILE; return 1; }
	while read -e TABLE; do
		drop_table "$TABLE" || { rm $LIST_FILE; return 1; }
	done <$LIST_FILE
	rm $LIST_FILE
}

function drop_table()
{
	local TABLE="$1"
	local QUERY="drop table \`$TABLE\`"
	local SCRIPT=`mktemp /tmp/my-admin-tools.XXXXXX`

	echo "set foreign_key_checks = off;" >$SCRIPT
	echo "$QUERY" >>$SCRIPT
	write_out "      $TABLE"
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH $SCHEMA <$SCRIPT 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	return $RC
}

function list_schemas()
{
	local OUT_FILE="$1"
	local QUERY="select schema_name from information_schema.schemata where schema_name not in ('mysql', 'information_schema', 'performance_schema', 'sys') order by 1"
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" >"$OUT_FILE" 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || return 1
	return 0
}

function list_tables()
{
	local SCHEMA=$1
	local OUTPUT=$2

	QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" >$OUTPUT 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || return 1
	sed -i -z -e 's/\r\n/\n/g' $OUTPUT || return 1
}

function print_options()
{
	write_out "Login path: $LOGIN_PATH"

	local AUX="(all)"
	if [ -n "$SCHEMA" ]; then
		AUX=$SCHEMA
	fi
	write_out "Schema: $AUX"
}

function run()
{
	LOGIN_PATH=client
	ANSWER_YES=0
	local SCHEMA=

	while getopts ":hl:s:y" opt; do
		case $opt in
			h)
				usage
				return 0;;
			l)
				LOGIN_PATH=$OPTARG;;
			s)
				SCHEMA="$OPTARG";;
			y)
				ANSWER_YES=1;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done

	shift $((OPTIND-1))
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi
	print_options
	confirm || return 1
	write_out "Dropping tables"
	if [ -n "$SCHEMA" ]; then
		drop_schema $SCHEMA || return 1
	else
		drop_all_schemas || return 1
	fi
}

function usage()
{
	echo "*** my-admin-tools ***"
	echo "my-drop-all-tables - Drop tables from a mysql database"
	echo "Usage: $0 [ -h ] [ -l <path> ] [ -s <schema> ]"
	echo "   -h: display help and exit"
	echo "   -l: use login path <path>"
	echo "      Default: 'client'"
	echo "   -s: drop only from schema <schema>."
	echo "      Default: drop from all schemas"
	echo "Credentials must be saved using 'mysql_config_editor'"
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +"%d %H:%M:%S"`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	echo -e "$MSG"
	return 0
}

function write_out()
{
	local MSG="$1"
	local TS=`date +"%d %H:%M:%S"`
	echo -e "[$TS] $MSG"
}

run $*
RC=$?
exit $RC
