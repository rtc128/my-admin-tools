#!/bin/bash

function usage()
{
	echo "my-admin-tools: my-drop-all-tables - Drop all tables in a schema"
	echo "Usage: $0 [ -l <path> ] <schema>"
	echo "	 -l: use login path <path>"
	echo "			Default: 'client'"
	echo "Credentials must be saved using 'mysql_config_editor'"
}

function generate_script()
{
	local SCRIPT=$1

	echo "set foreign_key_checks = off;" >$SCRIPT
	QUERY="select concat('drop table ', table_name, ';') from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE'"
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" >>$SCRIPT || return 1
}

function run()
{
	LOGIN_PATH=client
	while getopts "l:" opt; do
		case $opt in
			l)
				LOGIN_PATH=$OPTARG;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done

	shift $((OPTIND-1))

	if [ $# -ne 1 ]; then
		usage
		return 1
	fi
	SCHEMA=$1

	local SCRIPT=`mktemp /tmp/my-admin-tools.XXXXXX`
	generate_script $SCRIPT || return 1
	mysql --login-path=$LOGIN_PATH $SCHEMA <$SCRIPT || return 1
	rm $SCRIPT
}

run $*
RC=$?
exit $RC
