#!/bin/bash

MAX_RETRY_COUNT=3
RETRY_INTERVAL=5

if [ "$DEBUG" == "1" ]; then
   set -xv
fi

function copy_all_grants()
{
	local QUERY="select user, host from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF || { rm $OUT_BUFF; return 1; }

	while read -r LINE; do
		local USER=`echo $LINE | cut -d \  -f 1`
		local HOST=`echo $LINE | cut -d \  -f 2`
		local SCHEMA=\`$USER\`@\`$HOST\`
		copy_grants $SCHEMA || return 1
	done <$OUT_BUFF
	rm $OUT_BUFF
	return 1
}

function copy_all_schemas()
{
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	list_schemas >$OUT_BUFF
	RC=$?
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local LIST=`cat $OUT_BUFF`
	rm $OUT_BUFF
	local S
	for S in $LIST; do
		copy_full_schema $S || return 1
	done
	return 0
}

function copy_events()
{
	write_out "Copying events [$SCHEMA]"
	mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --events --skip-triggers $SCHEMA | mysql --login-path=$DST $SCHEMA || return 1;
}

function copy_aws()
{
	SCHEMA_LIST=`mktemp /tmp/my-admin-tools.XXXXXX`
	list_schemas >$SCHEMA_LIST
	if [ $FINISH_MODE -eq 0 ]; then
		write_out "*** Copying structure from AWS RDS"
		copy_aws_startup || { rm $SCHEMA_LIST; return 1; }
	else
		write_out "*** Copying structure from AWS RDS (finish stage)"
		copy_aws_finish || { rm $SCHEMA_LIST; return 1; }
	fi
	if [ $COPY_ALL -eq 1 ]; then
		CREATE_TABLES=0
		ONLY_TABLE_STRUCTURE=0
		for S in `cat $SCHEMA_LIST`; do
			SCHEMA=$S
			copy_tables || { rm $SCHEMA_LIST; return 1; }
		done
		copy_virtual_columns || { rm $SCHEMA_LIST; return 1; }
	fi
	rm $SCHEMA_LIST
	write_out "*** Finished"
	return 0
}

function copy_aws_startup()
{
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi
	validate_options_aws || return 1

	CREATE_TABLES=0
	RC=$?
	[ $RC -eq 0 ] || { rm $SCHEMA_LIST; return 1; }

	create_all_schemas || { rm $SCHEMA_LIST; return 1; }
	copy_full_tables || { rm $SCHEMA_LIST; return 1; }
	drop_virtual_columns || { rm $SCHEMA_LIST; return 1; }

	#REMOVER
	#return 0

	copy_all_users || { rm $SCHEMA_LIST; return 1; }
	copy_schema_grants || return 1
	copy_table_grants || return 1
	copy_full_views || return 1
	copy_full_routines || { rm $SCHEMA_LIST; return 1; }
	copy_full_grants || return 1
	copy_full_events || return 1
	return 0
}

function copy_aws_finish()
{
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi
	validate_options_aws || return 1

	copy_virtual_columns || { rm $SCHEMA_LIST; return 1; }
	copy_full_triggers || return 1
	rm $SCHEMA_LIST
	return 0
}

function copy_full_events()
{
	local SCHEMA
	write_out "Creating events"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --skip-lock-tables --events --skip-triggers $SCHEMA | mysql --login-path=$DST $SCHEMA || return 1
	done
}

function copy_full_grants()
{
	write_out "Adding all privileges"
	local QUERY="select user, host from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	local BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }

	while read -r LINE; do
		local USER=`echo $LINE | cut -d \  -f 1`
		local HOST=`echo $LINE | cut -d \  -f 2`
		local FQ_USER=\`$USER\`@\`$HOST\`
		copy_grants $FQ_USER || return 1
	done <$BUFF
	rm $BUFF
}

function copy_full_routines()
{
	local SCHEMA
	write_out "Creating routines"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --skip-lock-tables --routines --skip-triggers $SCHEMA | mysql --login-path=$DST $SCHEMA || return 1
	done
}

function copy_full_tables()
{
	local SCHEMA 
	local VIEW_LIST=`mktemp /tmp/my-admin-tools.XXXXXX`
	write_out "Creating tables"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		local VIEW_OPT=
		list_views $SCHEMA >$VIEW_LIST || { rm $VIEW_LIST; return 1; }
		for V in `cat $VIEW_LIST`; do
			VIEW_OPT="$VIEW_OPT --ignore-table=$SCHEMA.$V"
		done
		mysqldump --login-path=$SRC --set-gtid-purged=off $VIEW_OPT --max-allowed-packet=32M --no-data --skip-add-drop-table --skip-add-locks --skip-lock-tables --skip-triggers $SCHEMA | sed -e 's/^CREATE TABLE /CREATE TABLE IF NOT EXISTS /' | mysql --login-path=$DST $SCHEMA || { rm $VIEW_LIST; return 1; }
	done
	rm $VIEW_LIST
	return 0
}

function copy_full_triggers()
{
	write_out "Creating triggers"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --skip-lock-tables $SCHEMA | mysql --login-path=$DST $SCHEMA || return 1
	done
}

function copy_full_views()
{
	local SCHEMA 
	write_out "Creating views"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		copy_views $SCHEMA || return 1
	done
	return 0
}

function copy_grants()
{
	local USER="$1"
	QUERY="show grants for $USER"
	mysql --login-path=$SRC -N -e "$QUERY" | grep -iv '^grant `rds' | grep -vw backup_history | sed -e 's/$/;/' | mysql --login-path=$DST || return 1
}

function copy_one_role()
{
	local ROLE="$1"
	write_out "   $ROLE"
	write_out "      Creating"
	QUERY="create role $ROLE"
	mysql --login-path=$DST -N -e "$QUERY" || return 1
	write_out "      Copying grants"
	copy_grants "$ROLE" || return 1
}

function copy_routines()
{
	write_out "Copying routines [$SCHEMA]"
	mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --routines --skip-triggers $SCHEMA | sed -e "s/\<DEFINER=\`.*\`@\`%\`/DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA || return 1;
}

function copy_tables()
{
	CANCEL=0
	if [ $COPY_CUSTOM_TABLES -eq 0 ]; then
		write_out "*** Copying tables [$SCHEMA]"
		list_tables || return 1
	else
		cp "$CUSTOM_TABLE_LIST_FILE" "$TABLE_LIST_FILE" || return 1
	fi
	: >>$LOCK_FILE
	LIST=`seq 1 $TH_COUNT`
	for I in $LIST; do
		th_main &
	done
	wait
	rm $LOCK_FILE
}

function copy_triggers()
{
	write_out "Copying triggers [$SCHEMA]"
	mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data $SCHEMA | sed -e "s/\<DEFINER=\`.*\`@\`%\`/DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA || return 1;
}

function copy_all_users()
{
	write_out "Creating users"
	QUERY="select user, host, authentication_string is null from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user())"
	local FILTER="user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	mysqldump --login-path=$SRC --set-gtid-purged=off --skip-triggers --skip-add-locks --skip-disable-keys --skip-add-drop-table --no-create-info --skip-lock-tables --insert-ignore --complete-insert --skip-extended-insert --hex-blob --set-gtid-purged=off --where "$FILTER" mysql user | mysql --login-path=$DST mysql || return 1
	mysql --login-path=$DST -e "flush privileges" || return 1
}

function copy_roles()
{
	local R

	write_out "Copying user roles"
	local QUERY="select user from mysql.user where user != '' and authentication_string = ''"
	local BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }
	local LIST=`cat $BUFF`
	for R in $LIST; do
		users_role_exists $R >$BUFF || { rm $BUFF; return 1; }
		local EXISTS=`cat $BUFF`
		if [ $EXISTS -eq 0 ]; then
			continue
		fi

		write_out "$R: $EXISTS"
	done
	rm $BUFF
}

function copy_table_grants()
{
	write_out "Adding table privileges"
	QUERY="select concat('grant ', tp.privilege_type, ' on ', tp.table_schema, '.', tp.table_name, ' to ', tp.grantee, ';') as cmd
			from information_schema.table_privileges tp
					join information_schema.tables t on tp.table_schema = t.table_schema and tp.table_name = t.table_name
			where t.table_type = 'BASE TABLE' and grantee not like '\'mysql.%'";
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || return 1
	mysql --login-path=$DST <$BUFF || return 1
	rm $BUFF
}

function copy_schema_grants()
{
	write_out "Adding schema privileges"
	QUERY="select concat('grant ', privilege_type, ' on ', table_schema, '.* to ', grantee, ';') as cmd
			from information_schema.schema_privileges
			where grantee not like '\'mysql.%' and replace(grantee, '\'', '') <> current_user()"
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || return 1
	mysql --login-path=$DST <$BUFF || return 1
	rm $BUFF
}

function copy_views()
{
	local SCHEMA=$1

	mysqldump --login-path=$SRC --set-gtid-purged=off --max-allowed-packet=32M --no-data --skip-add-drop-table --skip-add-locks --skip-lock-tables --skip-triggers $SCHEMA | sed -e 's/^CREATE TABLE /CREATE TABLE IF NOT EXISTS /' -e 's/ CREATE VIEW / CREATE OR REPLACE VIEW /' | mysql --login-path=$DST $SCHEMA || { rm $VIEW_LIST; return 1; }
	return 0

	QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'VIEW' order by 1"
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	LIST=`mysql --login-path=$SRC -N -e "$QUERY"` || return 1
	for VIEW in $LIST; do
		QUERY="drop view if exists $VIEW"
		mysql --login-path=$DST -e "$QUERY" $SCHEMA || { rm $BUFF; return 1; }
		QUERY="show create view $VIEW"
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA | awk -F '\t' '{ print $2; }' >$BUFF
		sed -e "s/\<DEFINER=\`.*\`@\`%\`/DEFINER=\`$SCHEMA\`/" $BUFF | mysql --login-path=$DST $SCHEMA || { rm $BUFF; return 1; }
	done
	rm $BUFF
}

function copy_virtual_columns()
{
	write_out "Creating virtual columns"
	local BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local QUERY="select table_schema, table_name, column_name from information_schema.columns where table_schema <> 'mysql' and extra = 'VIRTUAL GENERATED'"
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF
	while read -r LINE; do
		local TABLE_SCHEMA=`echo $LINE | awk '{ print $1; }'`
		local TABLE_NAME=`echo $LINE | awk '{ print $2; }'`
		local COLUMN_NAME=`echo $LINE | awk '{ print $3; }'`
		copy_one_virtual_column $TABLE_SCHEMA $TABLE_NAME $COLUMN_NAME || return 1
	done <$BUFF
	rm $BUFF
}

function create_all_schemas()
{
	local SCHEMA 
	write_out "Creating schemas"
	for SCHEMA in `cat $SCHEMA_LIST`; do
		QUERY="create schema if not exists $SCHEMA"
		mysql --login-path=$DST -e "$QUERY" || return 1
	done
	return 0
}

function create_table_if_not_exists()
{
	local TABLE=$1
	local SPOOL=`mktemp $SPOOL_DIR/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysqldump --login-path=$SRC --no-data --skip-add-drop-table --skip-add-locks --skip-lock-tables $SCHEMA $TABLE | sed -e "s/^CREATE TABLE /CREATE TABLE IF NOT EXISTS /">$SPOOL 2>$ERR_BUFF
	RC=$?
	cat $ERR_BUFF
	if [ $RC -ne 0 ]; then
		rm $SPOOL $ERR_BUFF
		return 1
	fi
	mysql --login-path=$DST $SCHEMA <$SPOOL 2>$ERR_BUFF
	RC=$?
	cat $ERR_BUFF
	rm $ERR_BUFF $SPOOL
	return $RC
}

function drop_all_triggers()
{
	local TABLE
	local TRIGGER
	local TRIGGER_LIST
	local UTABLE
	local UTRIGGER

	UTABLE=${TABLE^^}

	TABLE=$1
	QUERY="select trigger_name from information_schema.triggers where trigger_schema = '$SCHEMA' and event_object_table = '$TABLE'"
	ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	TRIGGER_LIST=`mysql --login-path=$DST -N -e "$QUERY" 2>$ERR_BUFF`
	RC=$?
	ERR_DESC=`cat $ERR_BUFF`
	rm $ERR_BUFF
	if [ $RC -ne 0 ]; then
		write_out "Table $UTABLE: cannot list triggers\n   $ERR_DESC"
		return 1
	fi

	ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	for TRIGGER in $TRIGGER_LIST; do UTRIGGER=${TRIGGER^^}
		QUERY="drop trigger $TRIGGER"
		mysql --login-path=$DST -e "$QUERY" $SCHEMA 2>$ERR_BUFF
		RC=$?
		if [ $RC -ne 0 ]; then
			ERR_DESC=`cat $ERR_BUFF`
			write_out "Table $UTABLE: cannot drop trigger $UTRIGGER\n   $ERR_DESC"
			rm $ERR_BUFF
			return 1
		fi
	done
	rm $ERR_BUFF
	return 0
}

function drop_virtual_columns()
{
	local QUERY

	write_out "Dropping virtual columns"
	QUERY="select concat('alter table ', table_schema, '.', table_name, ' drop column ', column_name, ';') as cmd from information_schema.columns where table_schema <> 'mysql' and extra = 'VIRTUAL GENERATED'"
	mysql --login-path=$DST -N -e "$QUERY" | mysql --login-path=$DST
}

function get_next_table()
{
	local L_TABLE

	{
		flock 3
		L_TABLE=`grep -v -m 1 '#' $TABLE_LIST_FILE`
		#if not found, return
		[ -n "$L_TABLE" ] || return
		#comment retrieved table
		sed -i -e "s/^$L_TABLE$/#$L_TABLE/" $TABLE_LIST_FILE
	} 3<$LOCK_FILE
	echo $L_TABLE
}

function list_schemas()
{
	local QUERY="select schema_name from information_schema.schemata where schema_name not in ('mysql', 'information_schema', 'performance_schema', 'sys')"
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	cat $ERR_BUFF >&2
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	cat $OUT_BUFF
	rm $OUT_BUFF
	return 0
}

function list_tables()
{
	if [ $RESUME -eq 1 ]; then
		if [ -f $TABLE_LIST_FILE ]; then
			#replace comments (tables that were in the middle of the copy when last cancelled)
			sed -i -e "s/^#//" $TABLE_LIST_FILE
			return 0
		fi
	else
		rm -f $TABLE_LIST_FILE || return 1
	fi
	BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	QUERY="select table_name, table_rows from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }
	#if no limit defined, just mount table list
	if [ $LIMIT_TRANSACTION_LENGTH -eq 0 ]; then
		awk '{ print $1; }' $BUFF >$TABLE_LIST_FILE
		rm $BUFF
		return 0
	fi
	#split each table
	local LINE
	while read -r LINE; do
		local TABLE=`echo $LINE | awk '{ print $1; }'`
		local ROWS=`echo $LINE | awk '{ print $2; }'`
		local FIRST=1
		while [ $FIRST -le $ROWS ]; do
			local LAST=$((FIRST+LIMIT_TRANSACTION_LENGTH-1))
			echo "$TABLE:$FIRST-$LAST" >>$TABLE_LIST_FILE
			FIRST=$((LAST+1))
		done
		LAST=$((99999999999))
		echo "$TABLE:$FIRST-$LAST" >>$TABLE_LIST_FILE
	done <$BUFF
	rm $BUFF
}

function list_views()
{
	SCHEMA=$1
	QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'VIEW'"
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }
	cat $BUFF
	rm $BUFF
	return 0
}

function run()
{
	local AWS=0
	local L_TABLE
	CANCEL=0
	CREATE_TABLES=1
	IGNORE_LIST_FILE=
	COPY_EVENTS=0
	COPY_GRANTS=0
	COPY_ROUTINES=0
	COPY_TABLES=0
	COPY_USERS=0
	FINISH_MODE=0
	LIMIT_TRANSACTION_LENGTH=0
	ONLY_TRIGGERS=0
	ONLY_TABLE_STRUCTURE=0
	COPY_VIEWS=0
	RESUME=0
	TH_COUNT=1
	COPY_ALL=0

	local opt

	while getopts "AEFGRSTVad:i:kl:n:rs:tU" opt; do
		case $opt in
			A)
				AWS=1;;
			a)
				COPY_ALL=1;;
			E)
				COPY_EVENTS=1;;
			F)
				FINISH_MODE=1;;
			G)
				COPY_GRANTS=1;;
			R)
				COPY_ROUTINES=1;;
			S)
				ONLY_TABLE_STRUCTURE=1;;
			T)
				COPY_TABLES=1;;
			U)
				COPY_USERS=1;;
			V)
				COPY_VIEWS=1;;
			d)
				DST=$OPTARG;;
			i)
				IGNORE_LIST_FILE=$OPTARG;;
			k)
				CREATE_TABLES=0;;
			l)
				LIMIT_TRANSACTION_LENGTH=$OPTARG
				CREATE_TABLES=0;;
			n)
				TH_COUNT=$OPTARG;;
			r)
				RESUME=1;;
			s)
				SRC=$OPTARG;;
			t)
				ONLY_TRIGGERS=1;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))

	COPY_CUSTOM_TABLES=0
	CONFIG_FILE=/etc/my-mirror.conf
	SPOOL_DIR=/tmp
	read_config || return 1
	mkdir -p "$SPOOL_DIR" || return 1
	mkdir -p "$WORK_DIR" || return 1
	if [ $LIMIT_TRANSACTION_LENGTH -ne 0 ]; then
		write_out "Spool directory: $SPOOL_DIR"
	fi
	LOCK_FILE=$WORK_DIR/.lock
	TABLE_LIST_FILE=$WORK_DIR/tables
	if [ $AWS -eq 1 ]; then
		validate_aws_options || return 1
		copy_aws $* || return 1
		return 0
	fi

	if [ $# -lt 1 -o $# -gt 2 ]; then
		usage
		return 1
	fi
	SCHEMA=$1
	if [ $# -eq 2 ]; then
		L_TABLE=$2
		COPY_CUSTOM_TABLES=1
	fi

	validate_options || return 1
	#if ignore list file informed, it must exist
	if [ -n "$IGNORE_LIST_FILE" -a ! -f "$IGNORE_LIST_FILE" ]; then
		write_out "$IGNORE_LIST_FILE: file not found"
		return 1
	fi
	if [ -n "$L_TABLE" ]; then
		copy_one_table_or_list "$L_TABLE" || return 1
		return 0
	fi
	if [ $COPY_EVENTS -eq 1 ]; then
		copy_events || return 1
	fi
	if [ $COPY_GRANTS -eq 1 ]; then
		copy_grants || return 1
	fi
	if [ $COPY_ROUTINES -eq 1 ]; then
		copy_routines || return 1
	fi
	if [ $COPY_TABLES -eq 1 ]; then
		if [ $ONLY_TRIGGERS -eq 1 ]; then
			copy_triggers || return 1
		else
			copy_tables || return 1
		fi
	fi
	if [ $COPY_USERS -eq 1 ]; then
		copy_all_users || return 1
	fi
	if [ $COPY_VIEWS -eq 1 ]; then
		copy_views $SCHEMA || return 1
	fi

	write_out "Finished"
}

function copy_one_table()
{
	local L_DUMP_OPT
	local L_EXIST
	local L_RETRY_COUNT
	local L_TABLE
	local L_UTABLE

	L_TABLE=$1
	local TABLE_MSG=$1
	if [ -n "$INTERVAL" ]; then
		L_TABLE=`echo $L_TABLE | cut -d : -f 1`
		TABLE_MSG="$L_TABLE"
	fi

	L_UTABLE=${L_TABLE^^}
	UTABLE_MSG=${TABLE_MSG^^}
	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $L_TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "Table $L_UTABLE is ignored"
			return 0
		fi
	fi
	local USCHEMA=${SCHEMA^^}
	write_out "Copying table $USCHEMA.$UTABLE_MSG"
	if ! drop_all_triggers $L_TABLE; then
		TXT="Aborting table $L_UTABLE"
		write_out "$TXT"
		return 1
	fi

	if [ $CREATE_TABLES -eq 0 ]; then
		L_EXIST=`table_exists $L_TABLE`
		if [ $L_EXIST -eq 1 ]; then
			L_DUMP_OPT="$L_DUMP_OPT --insert-ignore --no-create-info"
		fi
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		L_DUMP_OPT="$L_DUMP_OPT --no-data"
	fi

	L_RETRY_COUNT=0
	EXP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	IMP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysqldump --login-path=$SRC --hex-blob --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=32M --skip-lock-tables --skip-add-locks $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
	EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
	IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	while [ $EXP_SIZE -ne 0 -o $IMP_SIZE -ne 0 ]; do
		if [ $CANCEL -eq 1 ]; then
			break
		fi
		if [ $L_RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			TXT="$L_UTABLE: error again\n   Aborting"
			write_out "$TXT"
			CANCEL=1
			break
		fi
		EXP_MSG=`cat $EXP_ERR_BUFF`
		IMP_MSG=`cat $IMP_ERR_BUFF`
		ERR_MSG="\n   $IMP_MSG\n   $EXP_MSG"
		((L_RETRY_COUNT++))
		TXT="$L_UTABLE:$ERR_MSG\n   Retrying (#$L_RETRY_COUNT)"
		write_out "$TXT"
		sleep $RETRY_INTERVAL

		mysqldump --login-path=$SRC --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=32M --skip-lock-tables --skip-add-locks $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | sed -e "s/50017 DEFINER=\`.*\`@\`%\`/50017 DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
		EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
		IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	done
	rm $EXP_ERR_BUFF $IMP_ERR_BUFF
	local STATUS="finished"
	if [ $CANCEL -eq 1 ]; then
		STATUS="cancelled"
	fi
	write_out "Table $USCHEMA.$L_UTABLE $STATUS"
	return 0
}

function copy_one_table_or_list()
{
	local PARAM=$1

	CUSTOM_TABLE_LIST_FILE=
	if [[ $PARAM == @* ]]; then
		local F="${PARAM:1}"
		copy_table_custom_list $F || return 1
	else
		copy_one_table $PARAM || return 1
	fi
}

function copy_one_table_interval()
{
	local L_DUMP_OPT
	local L_EXIST
	local L_RETRY_COUNT
	local L_TABLE
	local L_UTABLE

	L_TABLE=$1
	local INTERVAL=$2
	L_UTABLE=${L_TABLE^^}
	local UTABLE_WITH_INT="$L_UTABLE [$INTERVAL]"
	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $L_TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "Table $L_UTABLE is ignored"
			return 0
		fi
	fi
	local FIRST=`echo $INTERVAL | cut -d "-" -f 1`
	#if first block, create table if not exists
	if [ $FIRST -eq 1 ]; then
		create_table_if_not_exists $L_TABLE || return 1
	fi

	local USCHEMA=${SCHEMA^^}
	write_out "Copying table $USCHEMA.$UTABLE_WITH_INT"
	if ! drop_all_triggers $L_TABLE; then
		write_out "Aborting"
		CANCEL=1
		return 1
	fi

	if [ $CREATE_TABLES -eq 0 ]; then
		L_EXIST=`table_exists $L_TABLE`
		if [ $L_EXIST -eq 1 ]; then
			L_DUMP_OPT="$L_DUMP_OPT --insert-ignore --no-create-info"
		fi
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		L_DUMP_OPT="$L_DUMP_OPT --no-data"
	fi

	local RETRY_COUNT=1
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local LAST=`echo $INTERVAL | cut -d "-" -f 2`
	local COUNT=$((LAST-FIRST+1))
	local WHERE="true limit $FIRST, $COUNT"
	local SPOOL=`mktemp $SPOOL_DIR/my-mirror.XXXXXX`
	mysqldump --login-path=$SRC --hex-blob --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=32M --insert-ignore --skip-lock-tables --skip-add-locks --where "$WHERE" --result-file "$SPOOL" $SCHEMA $L_TABLE 2>$ERR_BUFF
	local RC=$?
	cat $ERR_BUFF
	rm $ERR_BUFF
	while [ $RC -ne 0 ]; do
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			TXT="$UTABLE_WITH_INT: error again - Aborting"
			write_out "$TXT"
			CANCEL=1
			rm $SPOOL
			return 1
		fi
		sleep $RETRY_INTERVAL
		mysqldump --login-path=$SRC --hex-blob --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=32M --insert-ignore --skip-lock-tables --skip-add-locks --where "$WHERE" --result-file "$SPOOL" $SCHEMA $L_TABLE 2>$ERR_BUFF
		local RC=$?
		cat $ERR_BUFF
		rm $ERR_BUFF
		((RETRY_COUNT++))
	done
	local RETRY_COUNT=1
	mysql --login-path=$DST $SCHEMA <"$SPOOL" 2>$ERR_BUFF
	cat $ERR_BUFF
	rm $ERR_BUFF
	local RC=$?
	while [ $RC -ne 0 ]; do
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			TXT="$UTABLE_WITH_INT: error again - Aborting"
			write_out "$TXT"
			CANCEL=1
			rm $SPOOL
			return 1
		fi
		sleep $RETRY_INTERVAL
		mysql --login-path=$DST $SCHEMA <"$SPOOL" 2>$ERR_BUFF
		local RC=$?
		cat $ERR_BUFF
		rm $ERR_BUFF
		((RETRY_COUNT++))
	done
	rm $SPOOL
	write_out "Table $USCHEMA.$UTABLE_WITH_INT finished"
	return 0
}

function copy_one_virtual_column()
{
	local BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local QUERY="show create table $TABLE_SCHEMA.$TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -w $COLUMN_NAME | sed -e 's/,$//' | sed -e 's/\\/\\\\/g' >$BUFF || return 1
	local NEW_COL=`cat $BUFF`
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -B 1 -w $COLUMN_NAME | head -n 1 | awk -F \  '{ print $1; }' >$BUFF || return 1
	local PREV_COL=`cat $BUFF`
	rm $BUFF
	local QUERY="alter table $TABLE_SCHEMA.$TABLE_NAME add $NEW_COL after $PREV_COL"
	mysql --login-path=$DST -e "$QUERY" || return 1
}

function copy_table_custom_list()
{
	local F="$1"
		
	CUSTOM_TABLE_LIST_FILE="$F"
	if ! [ -f "$F" ]; then
		write_out "File not found: $F"
		return 1
	fi
	copy_tables || return 1
}

