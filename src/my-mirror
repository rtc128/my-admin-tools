		create_routines FUNCTION || return 1

		write_out "      Procedures"
		create_routines PROCEDURE || return 1
	done
}

function create_routines()
{
	local OBJ_TYPE=$1
	local DST_OBJ_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local SRC_OBJ_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local SQL_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"

	#list in src
	local QUERY="select routine_name from information_schema.routines where routine_type = '$OBJ_TYPE' and routine_schema = '$SCHEMA' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$SRC_OBJ_LIST 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#list routines in dst
	#same query
	mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF || return 1
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#each object
	for OBJ in `cat $SRC_OBJ_LIST`; do
		#if it already exists in dst, ignore it
		if grep -w $OBJ $DST_OBJ_LIST >/dev/null; then
			continue
		fi
		local QUERY="show create $OBJ_TYPE $OBJ"
		write_out "         $OBJ"
		local TMP="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA 2>$ERR_BUFF | awk -F '\t' '{print $3;}' | sed -e 's/\\n/\n/g' -e 's/\\t/\t/g' >$TMP
		local SIZE=`stat -c %s $ERR_BUFF`
		write_file_out $ERR_BUFF
		[ $SIZE -eq 0 ] || { rm $TMP $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
		echo 'delimiter //' >$SQL_BUFF
		cat $TMP >>$SQL_BUFF
		echo '//' >>$SQL_BUFF
		rm $TMP
		mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
	done

	rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF
}

function create_all_tables()
{
	local SCHEMA 
	write_out "Creating tables"

	local DST_OBJ_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local TABLE_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local SQL_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	for SCHEMA in `cat $SCHEMA_LIST_FILE`; do
		write_out "   $SCHEMA"
		#list tables in dst
		local QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
		mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }

		#list tables in src
		mysql --login-path=$SRC -N -e "$QUERY" >$TABLE_LIST 2>$ERR_BUFF || return 1
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
		#each table
		for TABLE in `cat $TABLE_LIST`; do
			#if it already exists in dst, ignore it
			if grep -w $TABLE $DST_OBJ_LIST >/dev/null; then
				continue
			fi
			write_out "      $TABLE"
			mysqldump --login-path=$SRC --set-gtid-purged=off --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --no-data --skip-add-drop-table --skip-add-locks --skip-lock-tables --skip-triggers $SCHEMA $TABLE 2>$ERR_BUFF | sed -e 's/^  KEY .*$//' -e 's/^  CONSTRAINT .*//' -e '/^$/d' | sed -z -e 's/,\n)/\n)/g' >$SQL_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
			mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			[ $RC -eq 0 ] || { write_file_out $SQL_BUFF; rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
		done
	done
	rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF
	return 0
}

