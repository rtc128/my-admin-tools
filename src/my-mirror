function run()
{
	local L_TABLE

	CONFIG_FILE=/etc/my-mirror.conf
	AWS=0
	CREATE_TABLES=1
	IGNORE_LIST_FILE=
	COPY_EVENTS=0
	COPY_GRANTS=0
	COPY_ROUTINES=0
	COPY_TABLES=0
	COPY_USERS=0
	DST=client
	FINISH_MODE=0
	LIMIT_PARTITION_SIZE=0
	ONLY_TRIGGERS=0
	ONLY_TABLE_STRUCTURE=0
	COPY_VIEWS=0
	TH_COUNT=1
	COPY_ALL=0
	AWS_SKIP_TO_DATA=0
	PART_LOCAL_DIR=
	RESUME=0
	FORCE_RESTART_COPY=0

	local opt

	while getopts "ADEFGRSTVab:c:d:hi:kl:n:rs:tU" opt; do
		case $opt in
			A)
				AWS=1;;
			a)
				COPY_ALL=1;;
			b)
				PART_LOCAL_DIR="$OPTARG";;
			c)
				CONFIG_FILE="$OPTARG";;
			D)
				AWS_SKIP_TO_DATA=1;;
			E)
				COPY_EVENTS=1;;
			G)
				COPY_GRANTS=1;;
			R)
				COPY_ROUTINES=1;;
			S)
				ONLY_TABLE_STRUCTURE=1;;
			T)
				COPY_TABLES=1;;
			U)
				COPY_USERS=1;;
			V)
				COPY_VIEWS=1;;
			d)
				DST=$OPTARG;;
			f)
				FINISH_MODE=1;;
			h)
				usage
				return 0;;
			i)
				IGNORE_LIST_FILE=$OPTARG;;
			k)
				CREATE_TABLES=0;;
			l)
				LIMIT_PARTITION_SIZE=$OPTARG
				CREATE_TABLES=0;;
			n)
				TH_COUNT=$OPTARG;;
			r)
				FORCE_RESTART_COPY=1;;
			s)
				SRC=$OPTARG;;
			t)
				ONLY_TRIGGERS=1;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))

	validate_options $* || return 1

	COPY_CUSTOM_TABLES=0
	read_config || return 1

	DST_WORK_DIR="$WORK_DIR/$SRC/$DST"
	mkdir -p "$DST_WORK_DIR" || return 1
	LOCK_FILE="$DST_WORK_DIR/.lock"

	if [ -n "$MY_ADMIN_TOOLS_MAX_RETRY_COUNT" ]; then
		MAX_RETRY_COUNT=$MY_ADMIN_TOOLS_MAX_RETRY_COUNT
	fi
	if [ -n "$MY_ADMIN_TOOLS_RETRY_INTERVAL" ]; then
		RETRY_INTERVAL=$MY_ADMIN_TOOLS_RETRY_INTERVAL
	fi

	local TMP_LOG_FILE="`mount_log_path`" || return 1
	write_out "Log file: $TMP_LOG_FILE"
	LOG_FILE="$TMP_LOG_FILE"
	convert_bytes $LIMIT_PARTITION_SIZE g || { write_out "Invalid partition limit"; return 1; }
	LIMIT_PARTITION_SIZE_BYTES=$RESULT

	print_options || return 1
	print_env

	CANCEL_FILE="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	echo 0 >$CANCEL_FILE || return 1

	if [ $AWS -eq 1 ]; then
		copy_aws $*
	else
		run_local $*
	fi
	local RC=$?
	rm $CANCEL_FILE
	if [ $RC -eq 0 ]; then
		write_out "Operation finished successfully"
	else
		write_out "Operation cancelled"
	fi
	return $RC
}

function run_local()
{
	SCHEMA=$1
	if [ $# -eq 2 ]; then
		L_TABLE=$2
		COPY_CUSTOM_TABLES=1
	fi

	validate_options_local $* || return 1
	#if ignore list file informed, it must exist
	if [ -n "$IGNORE_LIST_FILE" -a ! -f "$IGNORE_LIST_FILE" ]; then
		write_out "$IGNORE_LIST_FILE: file not found"
		return 1
	fi

	if [ -n "$L_TABLE" ]; then
		TABLE_LIST_FILE="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		copy_one_table_or_list "$L_TABLE"
		local RC=$?
		rm $TABLE_LIST_FILE
		return $RC
	fi
	if [ $COPY_EVENTS -eq 1 ]; then
		write_out "Copying events"
		copy_events || return 1
	fi
	if [ $COPY_GRANTS -eq 1 ]; then
		copy_grants || return 1
	fi
	if [ $COPY_ROUTINES -eq 1 ]; then
		copy_routines || return 1
	fi
	if [ $COPY_TABLES -eq 1 ]; then
		if [ $ONLY_TRIGGERS -eq 1 ]; then
			copy_triggers || return 1
		else
			TABLE_LIST_FILE="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
			copy_tables
			local RC=$?
			rm $TABLE_LIST_FILE
			[ $RC -eq 0 ] || return 1
		fi
	fi
	if [ $COPY_USERS -eq 1 ]; then
		copy_all_users || return 1
	fi
	if [ $COPY_VIEWS -eq 1 ]; then
		copy_views $SCHEMA || return 1
	fi
}

function convert_bytes()
{
	local VALUE=$1
	local DEFAULT_UNIT=$2

	local LAST_CHAR="${VALUE: -1}"
	local REGEX='^[0-9]$'
	if [[ $LAST_CHAR =~ $REGEX ]] ; then
		VALUE=${VALUE}${DEFAULT_UNIT}
	fi
	local LAST_CHAR="${VALUE: -1}"
	local LAST_CHAR_LOWER="${LAST_CHAR,,}"
	VALUE="${VALUE:0:-1}"

	case $LAST_CHAR_LOWER in
		k)
			local MULT=1024;;
		m)
			local MULT=$((1024*1024));;
		g)
			local MULT=$((1024*1024*1025));;
		*)
			write_out "Invalid unit '$LAST_CHAR'"
			return 1
	esac
	RESULT=`echo $VALUE \* $MULT | bc`
}

function copy_one_table()
{
	local L_DUMP_OPT="--skip-disable-keys"
	local L_EXIST
	local RETRY_COUNT

	local TABLE=$1
	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $L_TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "      Table '$TABLE' is ignored"
			return 0
		fi
	fi
	write_out "      Starting table '$TABLE'"

	if [ $CREATE_TABLES -eq 0 ]; then
		L_EXIST=`table_exists $L_TABLE`
		if [ $L_EXIST -eq 1 ]; then
			L_DUMP_OPT="$L_DUMP_OPT --insert-ignore --no-create-info"
		fi
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		L_DUMP_OPT="$L_DUMP_OPT --no-data"
	fi

	RETRY_COUNT=0
	EXP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	IMP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local EXP_OPT="--login-path=$SRC --set-gtid-purged=off --hex-blob $L_DUMP_OPT --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --skip-lock-tables --skip-add-locks --skip-triggers"
	mysqldump $EXP_OPT $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
	EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
	IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	while [ $EXP_SIZE -ne 0 -o $IMP_SIZE -ne 0 ]; do
		write_file_out $EXP_ERR_BUFF
		write_file_out $IMP_ERR_BUFF
		local CANCEL=`cat $CANCEL_FILE`
		if [ $CANCEL -eq 1 ]; then
			break
		fi
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			TXT="      Table '$TABLE': error again"
			write_out "$TXT"
			echo 1 >$CANCEL_FILE
			break
		fi
		EXP_MSG=`cat $EXP_ERR_BUFF`
		IMP_MSG=`cat $IMP_ERR_BUFF`
		ERR_MSG="\n   $IMP_MSG\n   $EXP_MSG"
		((RETRY_COUNT++))
		local TXT="      Table '$TABLE': error - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
		write_out "$TXT"
		sleep $RETRY_INTERVAL

		mysqldump $EXP_OPT $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | sed -e "s/50017 DEFINER=\`.*\`@\`%\`/50017 DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
		EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
		IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	done
	rm $EXP_ERR_BUFF $IMP_ERR_BUFF
	local CANCEL=`cat $CANCEL_FILE`
	if [ $CANCEL -eq 0 ]; then
		write_out "      Finished table '$TABLE'"
	fi
	return $CANCEL
}

function copy_one_table_constraints()
{
	write_out "      Starting table '$TABLE'"
	local QUERY="show create table \`$TABLE\`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { $OUT_BUFF; return 1; }
	sed -i -e 's/\\n/\n/g' -e 's/\\t/\t/g' $OUT_BUFF
	sed -i -e 's/,$//' $OUT_BUFF
	local DEF_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	grep -E '^  CONSTRAINT' $OUT_BUFF | sed -e 's/^  //' >$DEF_BUFF
	rm $OUT_BUFF
	local SIZE=`stat -c %s $DEF_BUFF`
	if [ $SIZE -eq 0 ]; then
		rm $DEF_BUFF
		return 0
	fi

	sed -i -E -e "s/^(CONSTRAINT .*)/ALTER TABLE $TABLE ADD \1\;/" $DEF_BUFF

	local PROC_RET_CODE=0
	while read -e QUERY; do
		local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		mysql --login-path=$DST -e "set foreign_key_checks=off, sql_mode=''; $QUERY" "$SCHEMA" 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		[ $RC -eq 0 ] || { write_out "$QUERY"; PROC_RET_CODE=1; break; }
	done <$DEF_BUFF

	rm $DEF_BUFF
	if [ $PROC_RET_CODE -eq 0 ]; then
		write_out "      Finished table '$TABLE'"
	else
		echo 1 >$CANCEL_FILE
	fi
	return $PROC_RET_CODE
}

function copy_one_table_indexes()
{
	write_out "      Starting table '$TABLE'"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"

	local QUERY="show create table \`$TABLE\`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	sed -i -e 's/\\n/\n/g' -e 's/\\t/\t/g' $OUT_BUFF
	sed -i -e 's/,$//' $OUT_BUFF
	local DEF_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	grep -E '^  KEY' $OUT_BUFF | sed -e 's/^  //' >$DEF_BUFF
	rm $OUT_BUFF
	local SIZE=`stat -c %s $DEF_BUFF`
	if [ $SIZE -eq 0 ]; then
		rm $DEF_BUFF
		return 0
	fi

	if [ "$DEBUG" == "1" ]; then
		echo "Definition buffer before replacing:" >&2
		cat $DEF_BUFF >&2
	fi
	sed -i -E -e "s/^(KEY .*)/ALTER TABLE \`$TABLE\` ADD \1\;/" $DEF_BUFF
	if [ "$DEBUG" == "1" ]; then
		echo "Definition buffer after replacing:" >&2
		cat $DEF_BUFF >&2
	fi

	local PROC_RET_CODE=0
	while read -e QUERY; do
		local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		mysql --login-path=$DST -e "set sql_mode=''; $QUERY" "$SCHEMA" 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		[ $RC -eq 0 ] || { write_out "   $QUERY"; PROC_RET_CODE=1; break; }
	done <$DEF_BUFF

	rm $DEF_BUFF
	if [ $PROC_RET_CODE -eq 0 ]; then
		write_out "      Finished table '$TABLE'"
	else
		echo 1 >$CANCEL_FILE
	fi
}

function copy_one_table_or_list()
{
	local PARAM=$1

	CUSTOM_TABLE_LIST_FILE=
	if [[ $PARAM == @* ]]; then
		local F="${PARAM:1}"
		copy_table_custom_list $F || return 1
	else
		copy_one_table $PARAM || return 1
	fi
}

function copy_one_table_interval()
{
	local LINE="$1"
	local TABLE=`echo $LINE | cut -d : -f 1`

	local BY_TS=0
	local BY_PK=0
	local BY_ROWNUM=0

	local SPLIT_TYPE=`echo $LINE | cut -d : -f 2`
	local COL_NAME=`echo $LINE | cut -d : -f 3`
	local FIRST=`echo $LINE | cut -d : -f 4`
	local LAST=`echo $LINE | cut -d : -f 5`

	if [ "$SPLIT_TYPE" == "t" ]; then
		BY_TS=1
	fi
	if [ "$SPLIT_TYPE" == "p" ]; then
		BY_PK=1
	fi
	if [ "$SPLIT_TYPE" == "n" ]; then
		BY_ROWNUM=1
	fi

	if [ $BY_TS -eq 1 ]; then
		if [ -n "$FIRST" ]; then
			 FIRST_EXT="`date -d @$FIRST +\"%Y-%m-%d %H:%M:%S\"`"
			 LAST_EXT="`date -d @$LAST +\"%Y-%m-%d %H:%M:%S\"`"
			 TABLE_WITH_INT="$TABLE [$COL_NAME $FIRST_EXT to $LAST_EXT]"
			 WHERE="$COL_NAME between '$FIRST_EXT' and '$LAST_EXT'"
		else
			 TABLE_WITH_INT="$TABLE [$COL_NAME NULL]"
			 WHERE="$COL_NAME is null"
		fi
	fi
	if [ $BY_PK -eq 1 ]; then
		local TABLE_WITH_INT="$TABLE ['$COL_NAME' $FIRST to $LAST]"
		local WHERE="$COL_NAME between $FIRST and $LAST"
	fi
	if [ $BY_ROWNUM -eq 1 ]; then
		local COUNT=$((LAST-FIRST+1))
		local TABLE_WITH_INT="$TABLE [rows #$FIRST to #$LAST]"

		local FIRST_ROW_DB=$((FIRST-1))
		local WHERE="true limit $FIRST_ROW_DB, $COUNT"
	fi
	write_out "      Starting table '$TABLE_WITH_INT'"

	local L_EXIST
	local L_RETRY_COUNT

	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "      Table '$TABLE' is ignored"
			return 0
		fi
	fi

	local EXP_OPT="--login-path=$SRC --set-gtid-purged=off --insert-ignore --hex-blob --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --skip-lock-tables --skip-add-locks --skip-triggers --skip-disable-keys"
	if [ $CREATE_TABLES -eq 0 ]; then
		local EXP_OPT="$EXP_OPT --no-create-info"
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		local EXP_OPT="$EXP_OPT --no-data"
	fi

	local RETRY_COUNT=1
	local EXP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local IMP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local IMP_OPT="--login-path=$DST"
	mysqldump $EXP_OPT --where "$WHERE" $SCHEMA $TABLE 2>$EXP_ERR_BUFF | mysql $IMP_OPT $SCHEMA 2>$IMP_ERR_BUFF
	write_file_out $EXP_ERR_BUFF
	write_file_out $IMP_ERR_BUFF
	local EXP_ERR_LEN=`stat -c %s $EXP_ERR_BUFF`
	rm $EXP_ERR_BUFF
	local IMP_ERR_LEN=`stat -c %s $IMP_ERR_BUFF`
	rm $IMP_ERR_BUFF
	local CANCEL=`cat $CANCEL_FILE`
	while [ $EXP_ERR_LEN -ne 0 -o $IMP_ERR_LEN -ne 0 ]; do
		[ $CANCEL -eq 0 ] || return 1
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			local TXT="Table '$TABLE_WITH_INT': error again"
			write_out "$TXT"
			echo 1 >$CANCEL_FILE
			return 1
		fi
		((RETRY_COUNT++))
		local TXT="   Table '$TABLE_WITH_INT': error - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
		write_out "$TXT"
		sleep $RETRY_INTERVAL
		local EXP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		local IMP_ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		mysqldump $EXP_OPT --where "$WHERE" $SCHEMA $TABLE 2>$EXP_ERR_BUFF | mysql $IMP_OPT $SCHEMA 2>$IMP_ERR_BUFF
		write_file_out $EXP_ERR_BUFF
		write_file_out $IMP_ERR_BUFF
		local EXP_ERR_LEN=`stat -c %s $EXP_ERR_BUFF`
		rm $EXP_ERR_BUFF
		local IMP_ERR_LEN=`stat -c %s $IMP_ERR_BUFF`
		rm $IMP_ERR_BUFF
		local CANCEL=`cat $CANCEL_FILE`
	done
	write_out "      Finished table '$TABLE_WITH_INT'"
	return 0
}

function copy_one_virtual_column()
{
	local SCHEMA="$1"
	local TABLE="$2"
	local COLUMN="$3"

	#check if column already exists in dst
	write_out "   $SCHEMA.$TABLE.$COLUMN"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"

	local QUERY="desc $TABLE"
	mysql --login-path=$DST -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local COUNT=`grep -w $COLUMN $OUT_BUFF | wc -l`
	rm $OUT_BUFF
	[ $COUNT -eq 0 ] || return 0

	local BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="show create table $SCHEMA.$TABLE"
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -w $COLUMN | sed -e 's/,$//' | sed -e 's/\\/\\\\/g' >$BUFF || return 1
	local NEW_COL=`cat $BUFF`
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -B 1 -w $COLUMN | head -n 1 | awk -F \  '{ print $1; }' >$BUFF || return 1
	local PREV_COL=`cat $BUFF`
	rm $BUFF
	local QUERY="alter table $SCHEMA.$TABLE add $NEW_COL after $PREV_COL"
	mysql --login-path=$DST -e "$QUERY" || return 1
}

function copy_table_custom_list()
{
	local F="$1"
		
	CUSTOM_TABLE_LIST_FILE="$F"
	if ! [ -f "$F" ]; then
		write_out "File not found: $F"
		return 1
	fi
	copy_tables || return 1
}

