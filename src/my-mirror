function copy_all_grants()
{
	local QUERY="select user, host from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF || { rm $OUT_BUFF; return 1; }

	while read -r LINE; do
		local USER=`echo $LINE | cut -d \  -f 1`
		local HOST=`echo $LINE | cut -d \  -f 2`
		local SCHEMA=\`$USER\`@\`$HOST\`
		copy_grants $SCHEMA || return 1
	done <$OUT_BUFF
	rm $OUT_BUFF
	return 1
}

function copy_gtids()
{
	write_out "Copying purged GTID set"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "select @@gtid_executed" >"$OUT_BUFF" 2>"$ERR_BUFF"
	local RC=$?
	write_file_out "$ERR_BUFF"

	local GTID_SET="`cat \"$OUT_BUFF\"`"
	rm "$OUT_BUFF"
	local CMD="set global gtid_purged='+$GTID_SET';"
	local CMD_FILE="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	echo "$CMD" >"$CMD_FILE"
	mysql --login-path=$DST -N <"$CMD_FILE" 2>"$ERR_BUFF"
	local RC=$?
	rm "$CMD_FILE"
	write_file_out "$ERR_BUFF"
	rm "$ERR_BUFF"
	[ $RC -eq 0 ] || return 1
}

function create_events()
{
	local DST_OBJ_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local SRC_OBJ_LIST="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local SQL_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"

	#list events in src
	local QUERY="select event_name from information_schema.events where event_schema = '$SCHEMA' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$SRC_OBJ_LIST 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#list events in dst
	mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF || return 1
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#each object
	while read -r OBJ; do
		#if it already exists in dst, ignore it
		if grep "^$OBJ\$" $DST_OBJ_LIST >/dev/null; then
			continue
		fi
		local QUERY="show create event \`$OBJ\`"
		write_out "      $OBJ"
		local TMP="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA 2>$ERR_BUFF | awk -F '\t' '{print $4;}' | sed -e 's/\\n/\n/g' -e 's/\\t/\t/g' >$TMP
		local SIZE=`stat -c %s $ERR_BUFF`
		write_file_out $ERR_BUFF
		[ $SIZE -eq 0 ] || { rm $TMP $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
		echo "delimiter //" >$SQL_BUFF
		cat $TMP >>$SQL_BUFF
		rm $TMP
		echo "//" >>$SQL_BUFF
		mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
	done <$SRC_OBJ_LIST

	rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF
	return 0
}

function copy_aws()
{
	SCHEMA_LIST_FILE="$DST_WORK_DIR/.schemas"
	VALID_PENDING_STRUCT_FILE="$DST_WORK_DIR/.valid_struct"
	if [ $FINISH_MODE -eq 0 ]; then
		if [ -f "$VALID_PENDING_STRUCT_FILE" -a $FORCE_RESTART_COPY -eq 0 ]; then
			echo -n "Data copy from a previous session can be resumed. Do you wish to resume it ('Y' or 'y' / 'N' or 'n' / CTRL+C to abort)? "
			local ANSWER
			read ANSWER
			local U_ANSWER=${ANSWER^^}
			local HANDLED_ANSWER=0
			if [ "$U_ANSWER" == "Y" ]; then
				RESUME=1
				write_out "Resuming data copy"
				#LIMIT_PARTITION_SIZE=`crudini --get "$COPY_CONFIG_FILE" main limit_partition_size 2>/dev/null`
				HANDLED_ANSWER=1
			fi
			if [ "$U_ANSWER" == "N" ]; then
				rm -f "$VALID_PENDING_STRUCT_FILE"
				write_out "Restarting full AWS copy"
				write_out "Copying tables structures"
				list_schemas $SCHEMA_LIST_FILE || return 1
				copy_aws_startup || return 1
				HANDLED_ANSWER=1
			fi
			[ $HANDLED_ANSWER -eq 1 ] || { write_out "Cancelling"; return 1; }
		else
			write_out "Copying tables structures"
			list_schemas $SCHEMA_LIST_FILE || return 1
			copy_aws_startup || return 1
		fi
	else
		write_out "Copying database from AWS RDS (finish stage)"
		copy_aws_finish || return 1
	fi
	if [ $COPY_ALL -eq 1 ]; then
		CREATE_TABLES=0
		ONLY_TABLE_STRUCTURE=0
		copy_all_table_data || return 1
		rm -f "$VALID_PENDING_STRUCT_FILE"
		#rm -f "$VALID_PENDING_STRUCT_FILE" "$COPY_CONFIG_FILE"
		copy_aws_finish || return 1
		rm -fr "$DST_WORK_DIR/schemas"
	fi

	rm -f "$TABLE_LIST_FILE" "$SCHEMA_LIST_FILE"
	return 0
}

function copy_aws_startup()
{
	#save information about copy config
	#local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	#crudini --set "$COPY_CONFIG_FILE" main limit_partition_size $LIMIT_PARTITION_SIZE >$ERR_BUFF
	#local RC=$?
	#write_file_out $ERR_BUFF
	#rm $ERR_BUFF
	#[ $RC -eq 0 ] || return 1

	CREATE_TABLES=0
	RC=$?
	[ $RC -eq 0 ] || return 1

	rm -f "$VALID_PENDING_STRUCT_FILE"
	create_all_schemas || return 1
	create_all_tables || return 1
	drop_virtual_columns || return 1
	copy_all_users || return 1
	copy_schema_grants || return 1
	copy_table_grants || return 1
	create_all_routines || return 1
	create_all_events || return 1
	return 0
}

function copy_aws_finish()
{
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi

	copy_virtual_columns || return 1
	copy_all_indexes || return 1
	copy_all_constraints || return 1
	create_all_views || return 1
	copy_full_grants || return 1
	copy_full_triggers || return 1
	copy_gtids || return 1
	return 0
}

