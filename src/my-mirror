	fi
	if [ $COPY_ALL -eq 1 ]; then
		write_out "AWS 'copy all' mode ON"
	fi
	write_out "Number of threads: $TH_COUNT"
	if [ $COPY_EVENTS -eq 1 ]; then
		write_out "Copy events: enabled"
	fi
	if [ $FINISH_MODE -eq 1 ]; then
		write_out "AWS 'finish mode' ON"
	fi
	if [ $COPY_GRANTS -eq 1 ]; then
