function copy_table_attachments()
{
	write_out "      $TABLE"

	local QUERY="show create table $TABLE"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	sed -i -e 's/\\n/\n/g' -e 's/\\t/\t/g' $OUT_BUFF
	sed -i -e 's/\t//g' $OUT_BUFF

	#check if there is at least one
	grep -E -m 1 '^  KEY|^  CONSTRAINT' $OUT_BUFF >/dev/null
	[ $? -eq 0 ] || { rm $OUT_BUFF; return 0; }

	local SQL_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	echo "set foreign_key_checks = off;" >$SQL_BUFF
	echo "set sql_mode = no_auto_value_on_zero;" >>$SQL_BUFF
	echo "alter table $TABLE add (" >>$SQL_BUFF
	grep -E '^  KEY|^  CONSTRAINT' $OUT_BUFF >>$SQL_BUFF
	rm $OUT_BUFF
	echo ");" >>$SQL_BUFF

	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { cat $SQL_BUFF; rm $SQL_BUFF; return 1; }
	rm $SQL_BUFF
	return 0
}

function copy_table_pk()
{
	write_out "      $TABLE"

	#check if table has PK in dst
	local QUERY="show create table $TABLE"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$DST -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }

	sed -i -e 's/\\n/\n/g' -e 's/\\t/\t/g' $OUT_BUFF
	#cat $OUT_BUFF
	#grep '^  PRIMARY KEY' $OUT_BUFF
	local COUNT=`grep '^  PRIMARY KEY' $OUT_BUFF | wc -l`
	rm $OUT_BUFF
	[ $COUNT -eq 0 ] || return 0

	local QUERY="show create table $TABLE"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	cp $OUT_BUFF /tmp/ddl.sql
	sed -i -e 's/\\n/\n/g' -e 's/\\t/\t/g' $OUT_BUFF
	sed -i -e 's/,$//' $OUT_BUFF
	local DEF="`grep '^  PRIMARY' $OUT_BUFF`"
	rm $OUT_BUFF
	if [ -z "$DEF" ]; then
		return 0
	fi
	QUERY="set sql_mode = no_auto_value_on_zero; alter table $TABLE add $DEF"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	mysql --login-path=$DST -N -e "$QUERY" $SCHEMA 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { echo "$QUERY"; return 1; }

	return 0
}

