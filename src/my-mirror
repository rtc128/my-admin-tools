function split_table()
{
	local TABLE_NAME="$1"
	local ROWS=$2
	local UTABLE_NAME=${TABLE^^}
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`

	write_out "Checking if table $UTABLE_NAME has a numeric single-column PK"
	local QUERY="desc $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }

	local PK_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	grep -w PRI $OUT_BUFF >$PK_BUFF
	rm $OUT_BUFF

	#if PK is a single column
	local COUNT_COLS=`cat $PK_BUFF | wc -l`
	if [ $COUNT_COLS -eq 1 ]; then
		local COL_NAME=`cat $PK_BUFF | awk '{print $1}'`
		local TYPE=`cat $PK_BUFF | awk '{print $2}'`
		rm $PK_BUFF
		local SIMPLE_TYPE=`echo $TYPE | sed -e 's/(.*)//'`
		if [ "$SIMPLE_TYPE" == "decimal" -o "$SIMPLE_TYPE" == "int" -o "$SIMPLE_TYPE" == "bigint" ]; then
			#PK can be used
			split_table_pk "$TABLE_NAME" "$COL_NAME" || return 1
		else
			split_table_rownum "$TABLE_NAME" $ROWS || return 1
		fi
	else
		rm $PK_BUFF
		split_table_rownum "$TABLE_NAME" $ROWS || return 1
	fi
}

function split_table_pk()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"
	local UTABLE_NAME="${TABLE_NAME^^}"
	local UCOL_NAME="${COL_NAME^^}"

	#get min
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select min($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MIN_VAL=`cat $OUT_BUFF`
	local PART_MIN_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	#get max
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select max($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MAX_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	write_out "Splitting table $UTABLE_NAME by PK ($UCOL_NAME)"

	local CANCEL=`cat $CANCEL_FILE`
	while [ $CANCEL -eq 0 ]; do
		local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		PERCENT=`echo "scale=0; ($PART_MIN_VAL - $MIN_VAL) * 100 / ($MAX_VAL - $MIN_VAL + 1)" | bc`
		write_out "  Reading partition in table $UTABLE_NAME: >>$PART_MIN_VAL ($PERCENT%)"
		local QUERY="select max($COL_NAME) from (select $COL_NAME from $TABLE_NAME where $COL_NAME between $PART_MIN_VAL and $MAX_VAL order by 1 limit $LIMIT_TRANSACTION_LENGTH) x"

		local RETRY_COUNT=1
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		while [ $RC -ne 0 ]; do
			rm $OUT_BUFF
			if [ $COUNT_RETRY -eq $MAX_RETRY_COUNT ]; then
				write_out "  Error reading partition in table $UTABLE_NAME - Max retries reached"
				return 1
			fi
			((RETRY_COUNT++))
			write_out "  Error reading partition in table $UTABLE_NAME - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
			sleep $RETRY_INTERVAL
			mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			rm $ERR_BUFF
		done
		local PART_MAX_VAL=`cat $OUT_BUFF`
		rm $OUT_BUFF
		if [ -z "$PART_MAX_VAL" -o "$PART_MAX_VAL" == "NULL" ]; then
			write_out "  Table splitting finished for table $UTABLE_NAME"
			break
		fi
		local LINE="$TABLE_NAME:$COL_NAME:$PART_MIN_VAL-$PART_MAX_VAL"
		echo "$LINE" >>$TABLE_LIST_FILE
		local PART_MIN_VAL=`echo $PART_MAX_VAL + 1 | bc`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

