#!/bin/bash

MAX_ALLOWED_PACKET_MB=4
MAX_RETRY_COUNT=10
RETRY_INTERVAL=15

if [ "$DEBUG" == "1" ]; then
   set -x
fi

function copy_all_grants()
{
	local QUERY="select user, host from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF || { rm $OUT_BUFF; return 1; }

	while read -r LINE; do
		local USER=`echo $LINE | cut -d \  -f 1`
		local HOST=`echo $LINE | cut -d \  -f 2`
		local SCHEMA=\`$USER\`@\`$HOST\`
		copy_grants $SCHEMA || return 1
	done <$OUT_BUFF
	rm $OUT_BUFF
	return 1
}

function create_events()
{
	local DST_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local SRC_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local SQL_BUFF=`mktemp /tmp/my-mirror.XXXXXX`

	#list events in src
	local QUERY="select event_name from information_schema.events where event_schema = '$SCHEMA' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$SRC_OBJ_LIST 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#list events in dst
	mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF || return 1
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#each object
	while read -r OBJ; do
		#if it already exists in dst, ignore it
		if grep "^$OBJ\$" $DST_OBJ_LIST >/dev/null; then
			continue
		fi
		local QUERY="show create event \`$OBJ\`"
		write_out "      $OBJ"
		local TMP=`mktemp /tmp/my-mirror.XXXXXX`
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA 2>$ERR_BUFF | awk -F '\t' '{print $4;}' | sed -e 's/\\n/\n/g' -e 's/\\t/\t/g' >$TMP
		local SIZE=`stat -c %s $ERR_BUFF`
		write_file_out $ERR_BUFF
		[ $SIZE -eq 0 ] || { rm $TMP $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
		echo "delimiter //" >$SQL_BUFF
		cat $TMP >>$SQL_BUFF
		rm $TMP
		echo "//" >>$SQL_BUFF
		mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
	done <$SRC_OBJ_LIST

	rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF
	return 0
}

function copy_aws()
{
	SCHEMA_LIST_FILE="$DST_WORK_DIR/.schemas"
	VALID_PENDING_STRUCT_FILE="$DST_WORK_DIR/.valid_struct"
	if [ $RESUME -eq 1 ]; then
		if ! [ -f "$VALID_PENDING_STRUCT_FILE" ]; then
			write_out "No valid pending data found - cannot resume"
			return 1
		fi
	fi
	if [ $FINISH_MODE -eq 0 ]; then
		if [ $RESUME -eq 0 ]; then
			write_out "Copying structure from AWS RDS"
			write_out "Listing schemas"
			list_schemas $SCHEMA_LIST_FILE || return 1
			copy_aws_startup || return 1
		fi
	else
		write_out "Copying database from AWS RDS (finish stage)"
		copy_aws_finish || return 1
	fi
	if [ $COPY_ALL -eq 1 ]; then
		CREATE_TABLES=0
		ONLY_TABLE_STRUCTURE=0
		if [ $RESUME -eq 0 ]; then
			list_all_tables || return 1
		fi
		touch "$VALID_PENDING_STRUCT_FILE"
		write_out "Copying table data"
		copy_all_tables || return 1
		copy_virtual_columns || return 1
		copy_full_triggers || return 1
		rm -fr "$DST_WORK_DIR/schemas"
	fi

	rm -f "$TABLE_LIST_FILE" "$SCHEMA_LIST_FILE" "$VALID_PENDING_STRUCT_FILE"
	return 0
}

function copy_aws_startup()
{
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi

	CREATE_TABLES=0
	RC=$?
	[ $RC -eq 0 ] || return 1

	create_all_schemas || return 1
	create_all_tables || return 1
	drop_virtual_columns || return 1
	copy_all_users || return 1
	copy_schema_grants || return 1
	copy_table_grants || return 1
	create_all_views || return 1
	create_all_routines || return 1
	copy_full_grants || return 1
	create_all_events || return 1
	return 0
}

function copy_aws_finish()
{
	if [ $# -ne 0 ]; then
		usage
		return 1
	fi

	copy_virtual_columns || return 1
	copy_full_triggers || return 1
	return 0
}

function create_all_events()
{
	local S
	write_out "Creating events"
	for S in `cat $SCHEMA_LIST_FILE`; do
		SCHEMA=$S
		write_out "   $SCHEMA"
		create_events || return 1
	done
}

function copy_full_grants()
{
	write_out "Adding all privileges"
	local QUERY="select user, host from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }

	while read -r LINE; do
		local USER=`echo $LINE | cut -d \  -f 1`
		write_out "   $USER"
		local HOST=`echo $LINE | cut -d \  -f 2`
		local FQ_USER=\`$USER\`@\`$HOST\`
		copy_grants $FQ_USER || { rm $OUT_BUFF; return 1; }
	done <$OUT_BUFF
	rm $OUT_BUFF
}

function create_all_routines()
{
	local SCHEMA
	write_out "Creating routines"
	for SCHEMA in `cat $SCHEMA_LIST_FILE`; do
		local CANCEL=`cat $CANCEL_FILE`
		[ $CANCEL -eq 0 ] || return 1

		write_out "   $SCHEMA"

		write_out "      Functions"
		create_routines FUNCTION || return 1

		write_out "      Procedures"
		create_routines PROCEDURE || return 1
	done
}

function create_routines()
{
	local OBJ_TYPE=$1
	local DST_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local SRC_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local SQL_BUFF=`mktemp /tmp/my-mirror.XXXXXX`

	#list in src
	local QUERY="select routine_name from information_schema.routines where routine_type = '$OBJ_TYPE' and routine_schema = '$SCHEMA' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$SRC_OBJ_LIST 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#list routines in dst
	#same query
	mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF || return 1
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	#each object
	for OBJ in `cat $SRC_OBJ_LIST`; do
		#if it already exists in dst, ignore it
		if grep -w $OBJ $DST_OBJ_LIST >/dev/null; then
			continue
		fi
		local QUERY="show create $OBJ_TYPE $OBJ"
		write_out "         $OBJ"
		local TMP=`mktemp /tmp/my-mirror.XXXXXX`
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA 2>$ERR_BUFF | awk -F '\t' '{print $3;}' | sed -e 's/\\n/\n/g' -e 's/\\t/\t/g' >$TMP
		local SIZE=`stat -c %s $ERR_BUFF`
		write_file_out $ERR_BUFF
		[ $SIZE -eq 0 ] || { rm $TMP $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
		echo 'delimiter //' >$SQL_BUFF
		cat $TMP >>$SQL_BUFF
		echo '//' >>$SQL_BUFF
		rm $TMP
		mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
	done

	rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF
}

function create_all_tables()
{
	local SCHEMA 
	write_out "Creating tables"

	local DST_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local TABLE_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local SQL_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	for SCHEMA in `cat $SCHEMA_LIST_FILE`; do
		write_out "   $SCHEMA"
		#list tables in dst
		local QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
		mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }

		#list tables in src
		mysql --login-path=$SRC -N -e "$QUERY" >$TABLE_LIST 2>$ERR_BUFF || return 1
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
		#each table
		for TABLE in `cat $TABLE_LIST`; do
			#if it already exists in dst, ignore it
			if grep -w $TABLE $DST_OBJ_LIST >/dev/null; then
				continue
			fi
			write_out "      $TABLE"
			mysqldump --login-path=$SRC --set-gtid-purged=off --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --no-data --skip-add-drop-table --skip-add-locks --skip-lock-tables --skip-triggers $SCHEMA $TABLE >$SQL_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
			mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF; return 1; }
		done
	done
	rm $DST_OBJ_LIST $ERR_BUFF $TABLE_LIST $SQL_BUFF
	return 0
}

function copy_full_triggers()
{
	write_out "Creating triggers"
	local LIST=`list_schemas` || return 1
	local S
	for S in $LIST; do
		write_out "   $S"
		mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data --skip-lock-tables $S | mysql --login-path=$DST $S || return 1
	done
}

function create_all_views()
{
	local SCHEMA 
	write_out "Creating views"
	for SCHEMA in `cat $SCHEMA_LIST_FILE`; do
		write_out "   $SCHEMA"
		copy_views || return 1
	done
	return 0
}

function copy_grants()
{
	local USER="$1"
	QUERY="show grants for $USER"
	mysql --login-path=$SRC -N -e "$QUERY" | grep -iv '^grant `rds' | grep -vw backup_history | sed -e 's/$/;/' | mysql --login-path=$DST || return 1
}

function copy_one_role()
{
	local ROLE="$1"
	write_out "   $ROLE"
	write_out "      Creating"
	QUERY="create role $ROLE"
	mysql --login-path=$DST -N -e "$QUERY" || return 1
	write_out "      Copying grants"
	copy_grants "$ROLE" || return 1
}

function copy_tables()
{
	if [ $AWS -eq 0 ]; then
		if [ -z "$CUSTOM_TABLE_LIST_FILE" ]; then
			list_tables || { rm -f "$TABLE_LIST_FILE"; return 1; }
		else
			cp "$CUSTOM_TABLE_LIST_FILE" "$TABLE_LIST_FILE" || return 1
		fi
	fi
	: >>$LOCK_FILE
	LIST=`seq 1 $TH_COUNT`
	for I in $LIST; do
		th_copy_table_data &
	done
	wait
	rm $LOCK_FILE
	local CANCEL=`cat $CANCEL_FILE`
	return $CANCEL
}

function copy_triggers()
{
	write_out "Copying triggers [$SCHEMA]"
	mysqldump --login-path=$SRC --set-gtid-purged=off --no-create-info --no-data $SCHEMA | sed -e "s/\<DEFINER=\`.*\`@\`%\`/DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA || return 1;
}

function copy_all_tables()
{
	for S in `ls $DST_WORK_DIR/schemas`; do
		SCHEMA=$S
		TABLE_LIST_FILE="$DST_WORK_DIR/schemas/$SCHEMA"
		#remove all comments
		sed -i -e "s/^#//" "$TABLE_LIST_FILE"
		write_out "   $SCHEMA"
		copy_tables || return 1
	done
}

function copy_all_users()
{
	write_out "Creating users"
	QUERY="select user, host, authentication_string is null from mysql.user where user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user())"
	local FILTER="user != '' and user not like 'mysql.%' and concat(user, '@', host) != (select current_user()) and user not like 'AWS%' and user not like 'rds%'"
	mysqldump --login-path=$SRC --set-gtid-purged=off --skip-triggers --skip-add-locks --skip-disable-keys --skip-add-drop-table --no-create-info --skip-lock-tables --insert-ignore --complete-insert --skip-extended-insert --hex-blob --set-gtid-purged=off --where "$FILTER" mysql user | mysql --login-path=$DST mysql || return 1
	mysql --login-path=$DST -e "flush privileges" || return 1
}

function copy_roles()
{
	local R

	write_out "Copying user roles"
	local QUERY="select user from mysql.user where user != '' and authentication_string = ''"
	local BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }
	local LIST=`cat $BUFF`
	for R in $LIST; do
		users_role_exists $R >$BUFF || { rm $BUFF; return 1; }
		local EXISTS=`cat $BUFF`
		if [ $EXISTS -eq 0 ]; then
			continue
		fi

		write_out "$R: $EXISTS"
	done
	rm $BUFF
}

function copy_table_grants()
{
	write_out "Adding table privileges"
	QUERY="select concat('grant ', tp.privilege_type, ' on ', tp.table_schema, '.', tp.table_name, ' to ', tp.grantee, ';') as cmd
			from information_schema.table_privileges tp
					join information_schema.tables t on tp.table_schema = t.table_schema and tp.table_name = t.table_name
			where t.table_type = 'BASE TABLE' and grantee not like '\'mysql.%'";
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || return 1
	mysql --login-path=$DST <$BUFF || return 1
	rm $BUFF
}

function copy_schema_grants()
{
	write_out "Adding schema privileges"
	QUERY="select concat('grant ', privilege_type, ' on ', table_schema, '.* to ', grantee, ';') as cmd
			from information_schema.schema_privileges
			where grantee not like '\'mysql.%' and replace(grantee, '\'', '') <> current_user()"
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || return 1
	mysql --login-path=$DST <$BUFF || return 1
	rm $BUFF
}

function copy_views()
{
	local PASSES=4
	local DST_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local SRC_OBJ_LIST=`mktemp /tmp/my-mirror.XXXXXX`
	local SQL_BUFF=`mktemp /tmp/my-mirror.XXXXXX`

	#list views in src
	local QUERY="select table_name from information_schema.views where table_schema = '$SCHEMA' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" >$SRC_OBJ_LIST 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

	local CUR_PASS=1
	while [ $CUR_PASS -le $PASSES ]; do
		#list views in dst
		local QUERY="select table_name from information_schema.views where table_schema = '$SCHEMA' order by 1"
		mysql --login-path=$DST -N -e "$QUERY" >$DST_OBJ_LIST 2>$ERR_BUFF || return 1
		local RC=$?
		write_file_out $ERR_BUFF
		[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }

		local HANDLE_ERR=0
		if [ $CUR_PASS -eq $PASSES ]; then
			HANDLE_ERR=1
		fi
		#each object
		for OBJ in `cat $SRC_OBJ_LIST`; do
			#if it already exists in dst, ignore it
			if grep -w $OBJ $DST_OBJ_LIST >/dev/null; then
				continue
			fi
			local QUERY="show create view $OBJ"
			write_out "      $OBJ"
			local TMP=`mktemp /tmp/my-mirror.XXXXXX`
			mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$TMP 2>$ERR_BUFF
			local RC=$?
			cut -f 2 $TMP >$SQL_BUFF
			rm $TMP
			write_file_out $ERR_BUFF
			[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
			mysql --login-path=$DST $SCHEMA <$SQL_BUFF 2>$ERR_BUFF
			local RC=$?
			if [ $HANDLE_ERR -eq 1 ]; then
				write_file_out $ERR_BUFF
				[ $RC -eq 0 ] || { rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF; return 1; }
			fi
		done
		((CUR_PASS++))
	done

	rm $DST_OBJ_LIST $ERR_BUFF $SRC_OBJ_LIST $SQL_BUFF
	return 0
}

function copy_virtual_columns()
{
	write_out "Creating virtual columns"
	local BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select table_schema, table_name, column_name from information_schema.columns where table_schema <> 'mysql' and extra = 'VIRTUAL GENERATED'"
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF
	while read -r LINE; do
		local TABLE_SCHEMA=`echo $LINE | awk '{ print $1; }'`
		local TABLE_NAME=`echo $LINE | awk '{ print $2; }'`
		local COLUMN_NAME=`echo $LINE | awk '{ print $3; }'`
		copy_one_virtual_column "$TABLE_SCHEMA" "$TABLE_NAME" "$COLUMN_NAME" || return 1
	done <$BUFF
	rm $BUFF
}

function create_all_schemas()
{
	local SCHEMA 
	write_out "Creating schemas"
	for SCHEMA in `cat $SCHEMA_LIST_FILE`; do
		write_out "   $SCHEMA"
		local QUERY="create schema if not exists $SCHEMA"
		local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX` || return 1
		mysql --login-path=$DST -e "$QUERY" 2>$ERR_BUFF 
		RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		[ $RC -eq 0 ] || return 1
	done
	return 0
}

function drop_all_triggers()
{
	local TABLE
	local TRIGGER
	local TRIGGER_LIST
	local UTRIGGER

	TABLE=$1
	QUERY="select trigger_name from information_schema.triggers where trigger_schema = '$SCHEMA' and event_object_table = '$TABLE'"
	ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	TRIGGER_LIST=`mysql --login-path=$DST -N -e "$QUERY" 2>$ERR_BUFF`
	RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	if [ $RC -ne 0 ]; then
		return 1
	fi

	ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	for TRIGGER in $TRIGGER_LIST; do UTRIGGER=${TRIGGER^^}
		QUERY="drop trigger $TRIGGER"
		mysql --login-path=$DST -e "$QUERY" $SCHEMA 2>$ERR_BUFF
		RC=$?
		write_file_out $ERR_BUFF
		if [ $RC -ne 0 ]; then
			write_out "Table '$TABLE': cannot drop trigger $UTRIGGER"
			rm $ERR_BUFF
			return 1
		fi
	done
	rm $ERR_BUFF
	return 0
}

function drop_virtual_columns()
{
	local QUERY

	write_out "Dropping virtual columns"
	QUERY="select concat('alter table ', table_schema, '.', table_name, ' drop column ', column_name, ';') as cmd from information_schema.columns where table_schema <> 'mysql' and extra = 'VIRTUAL GENERATED'"
	mysql --login-path=$DST -N -e "$QUERY" | mysql --login-path=$DST
}

function get_next_pre_table()
{
	local TABLE

	{
		flock 3
		TABLE=`grep -v -m 1 '#' $TABLE_PRE_LIST_FILE`
		#if not found, return
		[ -n "$TABLE" ] || return
		#comment retrieved table
		sed -i -e "s/^$TABLE$/#$TABLE/" $TABLE_PRE_LIST_FILE
	} 3<$LOCK_FILE
	echo $TABLE
}

function get_next_table()
{
	local TABLE
	{
		flock 3
		#count number of tables
		local COUNT=`cat $TABLE_LIST_FILE | wc -l`
		if [ $COUNT -gt 0 ]; then
			#generate a random number from 1 to COUNT
			local RND=`printf %d 0x$(openssl rand -hex 4)`
			local POS=$((RND % COUNT + 1))
			TABLE=`grep -v -m $POS '^#' $TABLE_LIST_FILE | tail -n 1`
			#if not found, return
			[ -n "$TABLE" ] || return
			#comment retrieved table
			sed -i -e "s/^$TABLE$/#$TABLE/" $TABLE_LIST_FILE
		fi
	} 3<$LOCK_FILE
	echo $TABLE
}

function list_all_tables()
{
	write_out "Listing tables"

	mkdir -p "$DST_WORK_DIR/schemas"
	rm -f "$DST_WORK_DIR/schemas/"*
	for S in `cat $SCHEMA_LIST_FILE`; do
		SCHEMA=$S
		TABLE_LIST_FILE="$DST_WORK_DIR/schemas/$SCHEMA"
		list_tables || return 1
	done
}

function list_schemas()
{
	local OUT_FILE="$1"
	local QUERY="select schema_name from information_schema.schemata where schema_name not in ('mysql', 'information_schema', 'performance_schema', 'sys')"
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	if [ -n "$OUT_FILE" ]; then
		mysql --login-path=$SRC -N -e "$QUERY" >"$OUT_FILE" 2>$ERR_BUFF
	else
		mysql --login-path=$SRC -N -e "$QUERY" 2>$ERR_BUFF
	fi
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || return 1
	return 0
}

function list_tables()
{
	write_out "   $SCHEMA"

	TABLE_PRE_LIST_FILE=`mktemp /tmp/my-mirror.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select table_name, round(table_rows * 1.1, 0), avg_row_length from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" 2>$ERR_BUFF | sed -e 's/\r//' >$TABLE_PRE_LIST_FILE
	local SIZE=`stat -c %s $ERR_BUFF`
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $SIZE -eq 0 ] || { rm $TABLE_PRE_LIST_FILE; return 1; }

	if [ $LIMIT_TRANSACTION_LENGTH_SIZE -eq 0 ]; then
		awk '{print $1;}' $TABLE_PRE_LIST_FILE >$TABLE_LIST_FILE || { rm $TABLE_PRE_LIST_FILE; return 1; }
		local RC=$?
		rm $TABLE_PRE_LIST_FILE
		return $RC
	fi

	#just copy or split each table
	: >>$LOCK_FILE
	LIST=`seq 1 $TH_COUNT`
	for I in $LIST; do
		list_tables_th &
	done
	wait

	rm $TABLE_PRE_LIST_FILE
	local CANCEL=`cat $CANCEL_FILE`
	return $CANCEL
}

function list_tables_th()
{
	local FULL_TABLE=`get_next_pre_table`
	while [ -n "$FULL_TABLE" ]; do
		local TABLE=`echo $FULL_TABLE | awk '{ print $1; }'`
		write_out "      Checking if table '$TABLE' must be partitioned"
		local TABLE_ROWS=`echo $FULL_TABLE | awk '{ print $2; }'`
		local ROW_SIZE=`echo $FULL_TABLE | awk '{ print $3; }'`
		local TABLE_SIZE=$((TABLE_ROWS * ROW_SIZE))

		#if no limit defined, just mount table list
		if [ $LIMIT_TRANSACTION_LENGTH_SIZE -eq 0 ]; then
			echo $TABLE >>$TABLE_LIST_FILE
		else
			#split tables
			local RC=0
			local LINE
			if [ $TABLE_SIZE -gt $LIMIT_TRANSACTION_LENGTH_SIZE_BYTES ]; then
				LIMIT_TRANSACTION_LENGTH_ROWS=$((LIMIT_TRANSACTION_LENGTH_SIZE_BYTES/ROW_SIZE))
				#check if there is a forced limit
				if [ -n "$MY_MIRROR_TXN_LEN_FORCE_LIMIT" ]; then
					if [ $MY_MIRROR_TXN_LEN_FORCE_LIMIT -lt $LIMIT_TRANSACTION_LENGTH_ROWS ]; then
						LIMIT_TRANSACTION_LENGTH_ROWS=$MY_MIRROR_TXN_LEN_FORCE_LIMIT
					fi
				fi
				split_table "$TABLE" $TABLE_ROWS || { echo 1 >$CANCEL_FILE; break; }
			else
				echo "$TABLE" >>$TABLE_LIST_FILE
			fi
		fi
		remove_line_from_file "#$FULL_TABLE" $TABLE_PRE_LIST_FILE
		local FULL_TABLE=`get_next_pre_table`
	done
}

function list_views()
{
	SCHEMA=$1
	QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'VIEW'"
	BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$BUFF || { rm $BUFF; return 1; }
	cat $BUFF
	rm $BUFF
	return 0
}

