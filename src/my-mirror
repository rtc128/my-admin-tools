function list_tables()
{
	write_out "   $SCHEMA"

	TABLE_PRE_LIST_FILE="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="select table_name, round(table_rows * 1.1, 0), avg_row_length from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' order by 1"
	mysql --login-path=$SRC -N -e "$QUERY" 2>$ERR_BUFF | sed -e 's/\r//' >$TABLE_PRE_LIST_FILE
	local SIZE=`stat -c %s $ERR_BUFF`
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $SIZE -eq 0 ] || { rm $TABLE_PRE_LIST_FILE; return 1; }

	if [ $LIMIT_PARTITION_SIZE_BYTES -eq 0 ]; then
		awk '{print $1;}' $TABLE_PRE_LIST_FILE >$TABLE_LIST_FILE || { rm $TABLE_PRE_LIST_FILE; return 1; }
		local RC=$?
		rm $TABLE_PRE_LIST_FILE
		return $RC
	fi

	#just copy or split each table
	: >>$LOCK_FILE
	LIST=`seq 1 $TH_COUNT`
	for I in $LIST; do
		list_tables_th &
	done
	wait

	rm $TABLE_PRE_LIST_FILE
	local CANCEL=`cat $CANCEL_FILE`
	return $CANCEL
}

function list_tables_simple()
