function run()
{
	local L_TABLE

	AWS=0
	CREATE_TABLES=1
	IGNORE_LIST_FILE=
	COPY_EVENTS=0
	COPY_GRANTS=0
	COPY_ROUTINES=0
	COPY_TABLES=0
	COPY_USERS=0
	DST=client
	FINISH_MODE=0
	LIMIT_TRANSACTION_LENGTH=
	LIMIT_TRANSACTION_LENGTH_SIZE=0
	LIMIT_TRANSACTION_LENGTH_DAYS=0
	ONLY_TRIGGERS=0
	ONLY_TABLE_STRUCTURE=0
	COPY_VIEWS=0
	RESUME=0
	TH_COUNT=1
	COPY_ALL=0
	AWS_SKIP_TO_DATA=0

	local opt

	while getopts "ADEFGRSTVad:i:kl:n:rs:tU" opt; do
		case $opt in
			A)
				AWS=1;;
			a)
				COPY_ALL=1;;
			D)
				AWS_SKIP_TO_DATA=1;;
			E)
				COPY_EVENTS=1;;
			G)
				COPY_GRANTS=1;;
			R)
				COPY_ROUTINES=1;;
			S)
				ONLY_TABLE_STRUCTURE=1;;
			T)
				COPY_TABLES=1;;
			U)
				COPY_USERS=1;;
			V)
				COPY_VIEWS=1;;
			d)
				DST=$OPTARG;;
			f)
				FINISH_MODE=1;;
			i)
				IGNORE_LIST_FILE=$OPTARG;;
			k)
				CREATE_TABLES=0;;
			l)
				LIMIT_TRANSACTION_LENGTH=$OPTARG
				CREATE_TABLES=0;;
			n)
				TH_COUNT=$OPTARG;;
			r)
				RESUME=1;;
			s)
				SRC=$OPTARG;;
			t)
				ONLY_TRIGGERS=1;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))

	validate_options $* || return 1

	COPY_CUSTOM_TABLES=0
	CONFIG_FILE=/etc/my-mirror.conf
	read_config || return 1

	DST_WORK_DIR="$WORK_DIR/$SRC/$DST"
	mkdir -p "$DST_WORK_DIR" || return 1
	LOCK_FILE="$DST_WORK_DIR/.lock"

	if [ -n "$MY_ADMIN_TOOLS_MAX_RETRY_COUNT" ]; then
		MAX_RETRY_COUNT=$MY_ADMIN_TOOLS_MAX_RETRY_COUNT
	fi
	if [ -n "$MY_ADMIN_TOOLS_RETRY_INTERVAL" ]; then
		RETRY_INTERVAL=$MY_ADMIN_TOOLS_RETRY_INTERVAL
	fi

	local TMP_LOG_FILE=`mount_log_path` || return 1
	write_out "Log file: $TMP_LOG_FILE"
	LOG_FILE="$TMP_LOG_FILE"
	print_options || return 1

	CANCEL_FILE=`mktemp /tmp/my-mirror.XXXXXX`
	echo 0 >$CANCEL_FILE || return 1

	LIMIT_TRANSACTION_LENGTH_SIZE_BYTES=$((LIMIT_TRANSACTION_LENGTH_SIZE * 1024 * 1024 * 1024))
	if [ $AWS -eq 1 ]; then
		copy_aws $*
	else
		run_local $*
	fi
	RC=$?
	rm $CANCEL_FILE
	if [ $RC -eq 0 ]; then
		write_out "Operation finished successfully"
	else
		write_out "Operation cancelled"
	fi
	return $RC
}

function run_local()
{
	SCHEMA=$1
	if [ $# -eq 2 ]; then
		L_TABLE=$2
		COPY_CUSTOM_TABLES=1
	fi

	validate_options_local $* || return 1
	#if ignore list file informed, it must exist
	if [ -n "$IGNORE_LIST_FILE" -a ! -f "$IGNORE_LIST_FILE" ]; then
		write_out "$IGNORE_LIST_FILE: file not found"
		return 1
	fi

	if [ -n "$L_TABLE" ]; then
		TABLE_LIST_FILE=`mktemp /tmp/my-mirror.XXXXXX`
		copy_one_table_or_list "$L_TABLE"
		local RC=$?
		rm $TABLE_LIST_FILE
		return $RC
	fi
	if [ $COPY_EVENTS -eq 1 ]; then
		write_out "Copying events"
		copy_events || return 1
	fi
	if [ $COPY_GRANTS -eq 1 ]; then
		copy_grants || return 1
	fi
	if [ $COPY_ROUTINES -eq 1 ]; then
		copy_routines || return 1
	fi
	if [ $COPY_TABLES -eq 1 ]; then
		if [ $ONLY_TRIGGERS -eq 1 ]; then
			copy_triggers || return 1
		else
			TABLE_LIST_FILE=`mktemp /tmp/my-mirror.XXXXXX`
			copy_tables
			local RC=$?
			rm $TABLE_LIST_FILE
			[ $RC -eq 0 ] || return 1
		fi
	fi
	if [ $COPY_USERS -eq 1 ]; then
		copy_all_users || return 1
	fi
	if [ $COPY_VIEWS -eq 1 ]; then
		copy_views $SCHEMA || return 1
	fi

	write_out "Finished"
}

function copy_one_table()
{
	local L_DUMP_OPT
	local L_EXIST
	local RETRY_COUNT

	local TABLE=$1
	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $L_TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "      Table '$TABLE' is ignored"
			return 0
		fi
	fi
	write_out "      Starting table '$TABLE'"

	if [ $CREATE_TABLES -eq 0 ]; then
		L_EXIST=`table_exists $L_TABLE`
		if [ $L_EXIST -eq 1 ]; then
			L_DUMP_OPT="$L_DUMP_OPT --insert-ignore --no-create-info"
		fi
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		L_DUMP_OPT="$L_DUMP_OPT --no-data"
	fi

	RETRY_COUNT=0
	EXP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	IMP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	mysqldump --login-path=$SRC --hex-blob --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --skip-lock-tables --skip-add-locks --skip-triggers $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
	EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
	IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	while [ $EXP_SIZE -ne 0 -o $IMP_SIZE -ne 0 ]; do
		write_file_out $EXP_ERR_BUFF
		write_file_out $IMP_ERR_BUFF
		local CANCEL=`cat $CANCEL_FILE`
		if [ $CANCEL -eq 1 ]; then
			break
		fi
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			TXT="      Table '$TABLE': error again"
			write_out "$TXT"
			echo 1 >$CANCEL_FILE
			break
		fi
		EXP_MSG=`cat $EXP_ERR_BUFF`
		IMP_MSG=`cat $IMP_ERR_BUFF`
		ERR_MSG="\n   $IMP_MSG\n   $EXP_MSG"
		((RETRY_COUNT++))
		local TXT="      Table '$TABLE': error - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
		write_out "$TXT"
		sleep $RETRY_INTERVAL

		mysqldump --login-path=$SRC --set-gtid-purged=off $L_DUMP_OPT --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --skip-lock-tables --skip-add-locks $SCHEMA $L_TABLE 2>$EXP_ERR_BUFF | sed -e "s/50017 DEFINER=\`.*\`@\`%\`/50017 DEFINER=\`$SCHEMA\`/" | mysql --login-path=$DST $SCHEMA 2>$IMP_ERR_BUFF
		EXP_SIZE=`stat -c %s $EXP_ERR_BUFF`
		IMP_SIZE=`stat -c %s $IMP_ERR_BUFF`
	done
	rm $EXP_ERR_BUFF $IMP_ERR_BUFF
	local CANCEL=`cat $CANCEL_FILE`
	if [ $CANCEL -eq 0 ]; then
		write_out "      Finished table '$TABLE'"
	fi
	return $CANCEL
}

function copy_one_table_or_list()
{
	local PARAM=$1

	CUSTOM_TABLE_LIST_FILE=
	if [[ $PARAM == @* ]]; then
		local F="${PARAM:1}"
		copy_table_custom_list $F || return 1
	else
		copy_one_table $PARAM || return 1
	fi
}

function copy_one_table_interval()
{
	local LINE="$1"
	local TABLE=`echo $LINE | cut -d : -f 1`

	local BY_TS=0
	local BY_PK=0
	local BY_ROWNUM=0

	local SPLIT_TYPE=`echo $LINE | cut -d : -f 2`
	local COL_NAME=`echo $LINE | cut -d : -f 3`
	local FIRST=`echo $LINE | cut -d : -f 4`
	local LAST=`echo $LINE | cut -d : -f 5`

	if [ "$SPLIT_TYPE" == "t" ]; then
		BY_TS=1
	fi
	if [ "$SPLIT_TYPE" == "p" ]; then
		BY_PK=1
	fi
	if [ "$SPLIT_TYPE" == "n" ]; then
		BY_ROWNUM=1
	fi

	if [ $BY_TS -eq 1 ]; then
		if [ -n "$FIRST" ]; then
			 FIRST_EXT="`date -d @$FIRST +\"%Y-%m-%d %H:%M:%S\"`"
			 LAST_EXT="`date -d @$LAST +\"%Y-%m-%d %H:%M:%S\"`"
			 TABLE_WITH_INT="$TABLE [$COL_NAME $FIRST_EXT to $LAST_EXT]"
			 WHERE="$COL_NAME between '$FIRST_EXT' and '$LAST_EXT'"
		else
			 TABLE_WITH_INT="$TABLE [$COL_NAME NULL]"
			 WHERE="$COL_NAME is null"
		fi
	fi
	if [ $BY_PK -eq 1 ]; then
		local TABLE_WITH_INT="$TABLE ['$COL_NAME' $FIRST to $LAST]"
		local WHERE="$COL_NAME between $FIRST and $LAST"
	fi
	if [ $BY_ROWNUM -eq 1 ]; then
		local COUNT=$((LAST-FIRST+1))
		local TABLE_WITH_INT="$TABLE [rows #$FIRST to #$LAST]"
		local WHERE="true limit $FIRST, $COUNT"
	fi
	write_out "      Starting table '$TABLE_WITH_INT'"

	local L_EXIST
	local L_RETRY_COUNT

	if [ -n "$IGNORE_LIST_FILE" -a -f "$IGNORE_LIST_FILE" ]; then
		if grep -wi $TABLE "$IGNORE_LIST_FILE" >/dev/null; then
			write_out "      Table '$TABLE' is ignored"
			return 0
		fi
	fi

	local EXP_OPT="--login-path=$SRC --insert-ignore --hex-blob --set-gtid-purged=off --max-allowed-packet=${MAX_ALLOWED_PACKET_MB}M --skip-lock-tables --skip-add-locks --skip-triggers"
	if [ $CREATE_TABLES -eq 0 ]; then
		local EXP_OPT="$EXP_OPT --no-create-info"
	fi
	if [ $ONLY_TABLE_STRUCTURE -eq 1 ]; then
		local EXP_OPT="$EXP_OPT --no-data"
	fi

	local RETRY_COUNT=1
	local EXP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local IMP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local IMP_OPT="--login-path=$DST"
	mysqldump $EXP_OPT --where "$WHERE" $SCHEMA $TABLE 2>$EXP_ERR_BUFF | mysql $IMP_OPT $SCHEMA 2>$IMP_ERR_BUFF
	write_file_out $EXP_ERR_BUFF
	write_file_out $IMP_ERR_BUFF
	local EXP_ERR_LEN=`stat -c %s $EXP_ERR_BUFF`
	rm $EXP_ERR_BUFF
	local IMP_ERR_LEN=`stat -c %s $IMP_ERR_BUFF`
	rm $IMP_ERR_BUFF
	local CANCEL=`cat $CANCEL_FILE`
	while [ $EXP_ERR_LEN -ne 0 -o $IMP_ERR_LEN -ne 0 ]; do
		[ $CANCEL -eq 0 ] || return 1
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			local TXT="Table '$TABLE_WITH_INT': error again"
			write_out "$TXT"
			echo 1 >$CANCEL_FILE
			return 1
		fi
		((RETRY_COUNT++))
		local TXT="   Table '$TABLE_WITH_INT': error - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
		write_out "$TXT"
		sleep $RETRY_INTERVAL
		local EXP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		local IMP_ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		mysqldump $EXP_OPT --where "$WHERE" $SCHEMA $TABLE 2>$EXP_ERR_BUFF | mysql $IMP_OPT $SCHEMA 2>$IMP_ERR_BUFF
		write_file_out $EXP_ERR_BUFF
		write_file_out $IMP_ERR_BUFF
		local EXP_ERR_LEN=`stat -c %s $EXP_ERR_BUFF`
		rm $EXP_ERR_BUFF
		local IMP_ERR_LEN=`stat -c %s $IMP_ERR_BUFF`
		rm $IMP_ERR_BUFF
		local CANCEL=`cat $CANCEL_FILE`
	done
	write_out "      Finished table '$TABLE_WITH_INT'"
	return 0
}

function copy_one_virtual_column()
{
	local SCHEMA="$1"
	local TABLE="$2"
	local COLUMN="$3"

	local BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="show create table $SCHEMA.$TABLE"
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -w $COLUMN | sed -e 's/,$//' | sed -e 's/\\/\\\\/g' >$BUFF || return 1
	local NEW_COL=`cat $BUFF`
	mysql --login-path=$SRC -N -e "$QUERY" | sed -e 's/\\n/\n/g' | grep -m 1 -B 1 -w $COLUMN | head -n 1 | awk -F \  '{ print $1; }' >$BUFF || return 1
	local PREV_COL=`cat $BUFF`
	rm $BUFF
	local QUERY="alter table $SCHEMA.$TABLE add $NEW_COL after $PREV_COL"
	mysql --login-path=$DST -e "$QUERY" || return 1
}

function copy_table_custom_list()
{
	local F="$1"
		
	CUSTOM_TABLE_LIST_FILE="$F"
	if ! [ -f "$F" ]; then
		write_out "File not found: $F"
		return 1
	fi
	copy_tables || return 1
}

function read_config()
{
	WORK_DIR=`crudini --get $CONFIG_FILE main work_dir 2>/dev/null`
	if [ -z "$WORK_DIR" ]; then
		WORK_DIR=/var/lib/my-admin-tools/my-mirror
	fi
}

function remove_line_from_file()
{
	local LINE="$1"
	local FPATH="$2"
	{
		flock 3
		sed -i -e "/^$LINE$/d" $FPATH
	} 3<$LOCK_FILE
}

function split_table()
{
	local TABLE="$1"
	local ROWS=$2
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local DESC=`mktemp /tmp/my-mirror.XXXXXX`

	write_out "      Describing table '$TABLE'"
	local QUERY="desc $TABLE"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$DESC 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DESC; return 1; }

	write_out "      Checking if table '$TABLE' has an indexed timestamp column"
	local COL_NAME=`grep -Ewi -m 1 '(date|datetime|timestamp).*mul' $DESC | awk '{print $1;}'`
	if [ -n "$COL_NAME" ]; then
		rm $DESC
		write_out "      Found an indexed timestamp column in table '$TABLE': $COL_NAME"
		split_table_ts "$TABLE" "$COL_NAME" || return 1
		write_out "      Partitioning for table $TABLE finished"
		return 0
	fi

	write_out "      Checking if table '$TABLE' has a numeric single-column PK"
	local PK_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	grep -w PRI $DESC >$PK_BUFF
	rm $DESC

	#if PK is a single column
	local COUNT_COLS=`cat $PK_BUFF | wc -l`
	if [ $COUNT_COLS -eq 1 ]; then
		local COL_NAME=`cat $PK_BUFF | awk '{print $1}'`
		local TYPE=`cat $PK_BUFF | awk '{print $2}'`
		local SIMPLE_TYPE=`echo $TYPE | sed -e 's/(.*)//'`
		if [ "$SIMPLE_TYPE" == "decimal" -o "$SIMPLE_TYPE" == "int" -o "$SIMPLE_TYPE" == "bigint" ]; then
			#PK can be used
			rm $PK_BUFF
			write_out "      Found a numeric single-column PK in table '$TABLE': $COL_NAME"
			split_table_pk "$TABLE" "$COL_NAME" || return 1
			write_out "      Partitioning for table '$TABLE' finished"
			return 0
		fi
	fi
	rm $PK_BUFF
	split_table_rownum "$TABLE" $ROWS || return 1
	write_out "      Partitioning for table '$TABLE' finished"
}

function split_table_pk()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"

	write_out "      Partitioning table '$TABLE_NAME' by PK ($COL_NAME) ($LIMIT_TRANSACTION_LENGTH_ROWS rows per partition)"

	#get min
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select min($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MIN_VAL=`cat $OUT_BUFF`
	local PART_MIN_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	#get max
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select max($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MAX_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	local CANCEL=`cat $CANCEL_FILE`
	while [ $CANCEL -eq 0 ]; do
		local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
		PERCENT=`echo "scale=0; ($PART_MIN_VAL - $MIN_VAL) * 100 / ($MAX_VAL - $MIN_VAL + 1)" | bc`
		write_out "      Table '$TABLE_NAME': reading partition: >>$PART_MIN_VAL ($PERCENT%)"
		local QUERY="select max($COL_NAME) from (select $COL_NAME from $TABLE_NAME where $COL_NAME between $PART_MIN_VAL and $MAX_VAL order by 1 limit $LIMIT_TRANSACTION_LENGTH_ROWS) x"

		local RETRY_COUNT=1
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		while [ $RC -ne 0 ]; do
			rm $OUT_BUFF
			if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
				write_out "      Error reading partition in table '$TABLE_NAME' - Max retries reached"
				return 1
			fi
			((RETRY_COUNT++))
			write_out "      Error reading partition in table '$TABLE_NAME' - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
			sleep $RETRY_INTERVAL
			mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			rm $ERR_BUFF
		done
		local PART_MAX_VAL=`cat $OUT_BUFF`
		rm $OUT_BUFF
		if [ -z "$PART_MAX_VAL" -o "$PART_MAX_VAL" == "NULL" ]; then
			write_out "      Partitioning finished for table '$TABLE_NAME'"
			break
		fi
		local LINE="$TABLE_NAME:p:$COL_NAME:$PART_MIN_VAL:$PART_MAX_VAL"
		echo "$LINE" >>$TABLE_LIST_FILE
		local PART_MIN_VAL=`echo $PART_MAX_VAL + 1 | bc`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

function split_table_ts()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"

	write_out "      Partitioning table '$TABLE_NAME' by timestamp ($COL_NAME)"
	#get min
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select date_format(min($COL_NAME), '%Y-%m-%d %H:%i:%S') from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local BATCH_MIN_VAL="`cat $OUT_BUFF`"
	rm $OUT_BUFF

	#get max
	local ERR_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local OUT_BUFF=`mktemp /tmp/my-mirror.XXXXXX`
	local QUERY="select date_format(max($COL_NAME), '%Y-%m-%d %H:%i:%S') from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local TABLE_MAX_VAL="`cat $OUT_BUFF`"
	local TABLE_MAX_VAL_UNIX=`date -d "$TABLE_MAX_VAL" +%s`
	rm $OUT_BUFF

	local WEEKS=0
	local LAST_BATCH=0

	local CANCEL=`cat $CANCEL_FILE`
	while [ $LAST_BATCH -eq 0 -a $CANCEL -eq 0 ]; do
		local BATCH_MIN_VAL_UNIX=`date -d "$BATCH_MIN_VAL" +%s`
		#add number of days
		local BATCH_MAX_VAL_UNIX=$((BATCH_MIN_VAL_UNIX+LIMIT_TRANSACTION_LENGTH_SECS-1))
		if [ $BATCH_MAX_VAL_UNIX -gt $TABLE_MAX_VAL_UNIX ]; then
			BATCH_MAX_VAL_UNIX=$TABLE_MAX_VAL_UNIX
			LAST_BATCH=1
		fi

		local LINE="$TABLE_NAME:t:$COL_NAME:$BATCH_MIN_VAL_UNIX:$BATCH_MAX_VAL_UNIX"
		echo "$LINE" >>$TABLE_LIST_FILE

		local AUX=$((BATCH_MAX_VAL_UNIX+1))
		BATCH_MIN_VAL="`date -d @$AUX +\"%Y-%m-%d %H:%M:%S\"`"
		CANCEL=`cat $CANCEL_FILE`
	done
	#rows with NULL
	local LINE="$TABLE_NAME:t:$COL_NAME::"
	echo "$LINE" >>$TABLE_LIST_FILE
}

function split_table_rownum()
{
	local TABLE_NAME="$1"
	local ROWS="$2"

	write_out "      Partitioning table '$TABLE_NAME' by row number ($LIMIT_TRANSACTION_LENGTH_ROWS rows per partition)"
	local FIRST=1
	while [ $FIRST -le $ROWS ]; do
		local LAST=$((FIRST+LIMIT_TRANSACTION_LENGTH_ROWS-1))
		echo "$TABLE:n::$FIRST:$LAST" >>$TABLE_LIST_FILE
		local FIRST=$((LAST+1))
	done
	local LAST=99999999999
	echo "$TABLE:n::$FIRST:$LAST" >>$TABLE_LIST_FILE
}

