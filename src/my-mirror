	echo "      MY_MIRROR_TXN_LEN_FORCE_LIMIT: for tables partitioned by PK, each partition will have no more than <MY_MIRROR_TXN_LEN_FORCE_LIMIT> rows, even if average row length is very small."
}

function validate_options()
{
	[ -n "$SRC" ] || { echo "Option 's' is required"; usage; return 1; }
	[ -n "$DST" ] || { echo "Option 'd' is required"; usage; return 1; }

	#options -r and -l can't be used together
	if [ -n "$LIMIT_TRANSACTION_LENGTH" -a $RESUME -eq 1 ]; then
		write_out "Options -l and -r cannot be used together"
		return 1
	fi

	if [ -n "$LIMIT_TRANSACTION_LENGTH" ]; then
		local AUX="${LIMIT_TRANSACTION_LENGTH//[^\/]}"
		local COUNT="${#AUX}"
		if [ $COUNT -ne 1 ]; then
			write_out "Invalid value for transaction length limit"
			usage
			return 1
		fi
		LIMIT_TRANSACTION_LENGTH_SIZE=`echo $LIMIT_TRANSACTION_LENGTH | cut -d / -f 1`
		LIMIT_TRANSACTION_LENGTH_DAYS=`echo $LIMIT_TRANSACTION_LENGTH | cut -d / -f 2`
		if [ -z "$LIMIT_TRANSACTION_LENGTH_DAYS" ]; then
			write_out "Invalid value for transaction length limit"
			usage
			return 1
		fi
		LIMIT_TRANSACTION_LENGTH_SECS=`echo scale=0\; $LIMIT_TRANSACTION_LENGTH_DAYS \* 60 \* 60 \* 24 / 1 | bc`
		if [ $LIMIT_TRANSACTION_LENGTH_SECS -eq 0 ]; then
			write_out "Invalid value for transaction length limit"
			usage
			return 1
		fi

		#transaction length limit
		if [ $LIMIT_TRANSACTION_LENGTH_SIZE -lt 1 -o $LIMIT_TRANSACTION_LENGTH_SIZE -gt 999999 ]; then
			write_out "Invalid value for transaction length limit"
			usage
			return 1
		fi
	fi

	if [ $AWS -eq 1 ]; then
		validate_options_aws $* || return 1
	fi
}

function validate_options_aws()
{
	#options -F and -a can't e used together
	if [ $COPY_ALL -eq 1 -a $FINISH_MODE -eq 1 ]; then
		echo "Options 'a' and 'F' cannot be used together"
		usage
		return 1
	fi
}

function validate_options_local()
{
	[ -n "$SRC" ] || { echo "Option 's' is required"; usage; return 1; }
	[ -n "$DST" ] || { echo "Option 'd' is required"; usage; return 1; }

	#if triggers requested, but tables not requested
	if [ $ONLY_TRIGGERS -eq 1 -a $COPY_TABLES -eq 0 ]; then
		echo "Triggers requested, but tables not requested"
		return 1
	fi

	#if no object type
	if [ $COPY_CUSTOM_TABLES -eq 0 -a $COPY_TABLES -eq 0 -a $COPY_EVENTS -eq 0 -a $COPY_GRANTS -eq 0 -a $COPY_ROUTINES -eq 0 -a $COPY_USERS -eq 0 -a $COPY_VIEWS -eq 0 ]; then
		echo "No item was requested. Use at least one of the following options: -E, -G, -R, -T, -U, -V. Or either inform a table/table list."
		return 1
	fi

	if [ $# -lt 1 -o $# -gt 2 ]; then
		usage
		return 1
	fi
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +"%d %H:%M:%S"`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	echo -e "$MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "$MSG" >>"$LOG_FILE"
	fi
	return 0
}

function write_out()
{
	MSG="$1"
	TS=`date +"%d %H:%M:%S"`
	echo -e "[$TS] $MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "[$TS] $MSG" >>"$LOG_FILE"
	fi
}

