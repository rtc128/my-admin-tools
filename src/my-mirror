{
	local LINE="$1"
	local FPATH="$2"
	{
		flock 3
		sed -i -e "/^$LINE$/d" $FPATH
	} 3<$LOCK_FILE
}

function split_table()
{
	local TABLE="$1"
	local ROWS=$2
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local DESC="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"

	write_out "      Describing table '$TABLE'"
	local QUERY="desc $TABLE"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$DESC 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $DESC; return 1; }

	write_out "      Checking if table '$TABLE' has a numeric single-column PK"
	local PK_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	grep -w PRI $DESC >$PK_BUFF
	rm $DESC

	#if PK is a single column
	local COUNT_COLS=`cat $PK_BUFF | wc -l`
	if [ $COUNT_COLS -eq 1 ]; then
		local COL_NAME=`cat $PK_BUFF | awk '{print $1}'`
		local TYPE=`cat $PK_BUFF | awk '{print $2}'`
		local SIMPLE_TYPE=`echo $TYPE | sed -e 's/(.*)//'`
		if [ "$SIMPLE_TYPE" == "decimal" -o "$SIMPLE_TYPE" == "int" -o "$SIMPLE_TYPE" == "bigint" ]; then
			write_out "      Found a numeric single-column PK in table '$TABLE': $COL_NAME"
			split_table_pk "$TABLE" "$COL_NAME" || return 1
		fi
	else
		split_table_rownum "$TABLE" $ROWS || return 1
	fi
	rm $PK_BUFF
}

function split_table_pk()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"

	write_out "      Partitioning table '$TABLE_NAME' by PK ($COL_NAME) ($LIMIT_PARTITION_SIZE_ROWS rows per partition)"
	if [ -z "$PART_LOCAL_DIR" ]; then
		split_table_pk_remote "$TABLE_NAME" "$COL_NAME" || return 1
	else
		split_table_pk_local "$TABLE_NAME" "$COL_NAME" || return 1
	fi
	write_out "      Partitioning finished for table '$TABLE_NAME'"
}

function split_table_pk_local()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local PK_BUFF="$PART_LOCAL_DIR/$TABLE_NAME"
	local PK
	local PART_MIN_VAL

	write_out "         Listing all PK values in table '$TABLE_NAME'"
	local RETRY_COUNT=1
	local QUERY="select $COL_NAME from $TABLE_NAME order by 1"
	mysql --login-path=$SRC -q -N -e "$QUERY" $SCHEMA >"$PK_BUFF" 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	while [ $RC -ne 0 ]; do
		rm "$PK_BUFF"
		if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
			write_out "         Error listing PKs in table '$TABLE_NAME' - Max retries reached"
			return 1
		fi
		((RETRY_COUNT++))
		write_out "         Error listing PKs in table '$TABLE_NAME' - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
		sleep $RETRY_INTERVAL
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >"$PK_BUFF" 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
	done

	write_out "         Visiting all PK values and mounting partitions for table '$TABLE_NAME'"
	local PART_COUNT=0
	local LAST_PK
	while read -e PK; do
		LAST_PK=$PK
		if [ -z "$PART_MIN_VAL" ]; then
			PART_MIN_VAL=$PK
			PART_LINE_COUNT=0
		fi
		((PART_LINE_COUNT++))
		if [ $PART_LINE_COUNT -eq $LIMIT_PARTITION_SIZE_ROWS ]; then
			local LINE="$TABLE_NAME:p:$COL_NAME:$PART_MIN_VAL:$PK"
			echo "$LINE" >>$TABLE_LIST_FILE
			PART_MIN_VAL=
			((PART_COUNT++))
			write_out "         Mounted partition #$PART_COUNT for table '$TABLE_NAME'"
			local CANCEL=`cat $CANCEL_FILE`
			[ $CANCEL -eq 0 ] || break
		fi
	done <"$PK_BUFF"
	rm "$PK_BUFF"

	if [ -n "$PART_MIN_VAL" ]; then
		local LINE="$TABLE_NAME:p:$COL_NAME:$PART_MIN_VAL:$LAST_PK"
		echo "$LINE" >>$TABLE_LIST_FILE
	fi
	write_out "         Partitioning finished for table '$TABLE_NAME'"
}

function split_table_pk_remote()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"

	#get min
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="select min($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MIN_VAL=`cat $OUT_BUFF`
	local PART_MIN_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	#get max
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="select max($COL_NAME) from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local MAX_VAL=`cat $OUT_BUFF`
	rm $OUT_BUFF

	local CANCEL=`cat $CANCEL_FILE`
	while [ $CANCEL -eq 0 ]; do
		local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
		PERCENT=`echo "scale=0; ($PART_MIN_VAL - $MIN_VAL) * 100 / ($MAX_VAL - $MIN_VAL + 1)" | bc`
		write_out "      Table '$TABLE_NAME': reading partition: >>$PART_MIN_VAL ($PERCENT%)"
		local QUERY="select max($COL_NAME) from (select $COL_NAME from $TABLE_NAME where $COL_NAME between $PART_MIN_VAL and $MAX_VAL order by 1 limit $LIMIT_PARTITION_SIZE_ROWS) x"

		local RETRY_COUNT=1
		mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		while [ $RC -ne 0 ]; do
			rm $OUT_BUFF
			if [ $RETRY_COUNT -eq $MAX_RETRY_COUNT ]; then
				write_out "      Error reading partition in table '$TABLE_NAME' - Max retries reached"
				return 1
			fi
			((RETRY_COUNT++))
			write_out "      Error reading partition in table '$TABLE_NAME' - retrying in $RETRY_INTERVAL seconds (#$RETRY_COUNT/#$MAX_RETRY_COUNT)"
			sleep $RETRY_INTERVAL
			mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
			local RC=$?
			write_file_out $ERR_BUFF
			rm $ERR_BUFF
		done
		local PART_MAX_VAL=`cat $OUT_BUFF`
		rm $OUT_BUFF
		if [ -z "$PART_MAX_VAL" -o "$PART_MAX_VAL" == "NULL" ]; then
			break
		fi
		local LINE="$TABLE_NAME:p:$COL_NAME:$PART_MIN_VAL:$PART_MAX_VAL"
		echo "$LINE" >>$TABLE_LIST_FILE
		local PART_MIN_VAL=`echo $PART_MAX_VAL + 1 | bc`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

function split_table_ts()
{
	local TABLE_NAME="$1"
	local COL_NAME="$2"

	write_out "      Partitioning table '$TABLE_NAME' by timestamp ($COL_NAME)"
	#get min
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="select date_format(min($COL_NAME), '%Y-%m-%d %H:%i:%S') from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local BATCH_MIN_VAL="`cat $OUT_BUFF`"
	rm $OUT_BUFF

	#get max
	local ERR_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local QUERY="select date_format(max($COL_NAME), '%Y-%m-%d %H:%i:%S') from $TABLE_NAME"
	mysql --login-path=$SRC -N -e "$QUERY" $SCHEMA >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local TABLE_MAX_VAL="`cat $OUT_BUFF`"
	local TABLE_MAX_VAL_UNIX=`date -d "$TABLE_MAX_VAL" +%s`
	rm $OUT_BUFF

	local WEEKS=0
	local LAST_BATCH=0

	local CANCEL=`cat $CANCEL_FILE`
	while [ $LAST_BATCH -eq 0 -a $CANCEL -eq 0 ]; do
		local BATCH_MIN_VAL_UNIX=`date -d "$BATCH_MIN_VAL" +%s`
		#add number of days
		local BATCH_MAX_VAL_UNIX=$((BATCH_MIN_VAL_UNIX+LIMIT_PARTITION_SIZE_SECS-1))
		if [ $BATCH_MAX_VAL_UNIX -gt $TABLE_MAX_VAL_UNIX ]; then
			BATCH_MAX_VAL_UNIX=$TABLE_MAX_VAL_UNIX
			LAST_BATCH=1
		fi

		local LINE="$TABLE_NAME:t:$COL_NAME:$BATCH_MIN_VAL_UNIX:$BATCH_MAX_VAL_UNIX"
		echo "$LINE" >>$TABLE_LIST_FILE

		local AUX=$((BATCH_MAX_VAL_UNIX+1))
		BATCH_MIN_VAL="`date -d @$AUX +\"%Y-%m-%d %H:%M:%S\"`"
		CANCEL=`cat $CANCEL_FILE`
	done
	#rows with NULL
	local LINE="$TABLE_NAME:t:$COL_NAME::"
	echo "$LINE" >>$TABLE_LIST_FILE
}

function split_table_rownum()
{
	local TABLE_NAME="$1"
	local ROWS="$2"

	write_out "      Partitioning table '$TABLE_NAME' by row number ($LIMIT_PARTITION_SIZE_ROWS rows per partition)"
	local FIRST=1
	while [ $FIRST -le $ROWS ]; do
		local LAST=$((FIRST+LIMIT_PARTITION_SIZE_ROWS-1))
		echo "$TABLE:n::$FIRST:$LAST" >>$TABLE_LIST_FILE
		local FIRST=$((LAST+1))
	done
	local LAST=99999999999
	echo "$TABLE:n::$FIRST:$LAST" >>$TABLE_LIST_FILE
}

function table_exists()
{
	local L_COUNT
	local L_QUERY
	local L_TABLE

	L_TABLE=$1
	L_QUERY="select count(1) from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE' and table_name = '$L_TABLE'"
	L_COUNT=`mysql --login-path=$DST -N -e "$L_QUERY" $SCHEMA`
	echo $L_COUNT
}

function th_copy_table_constraints()
{
	local CANCEL=`cat $CANCEL_FILE`
	TABLE="`get_next_table`"
	while [ -n "$TABLE" -a $CANCEL -eq 0 ]; do
		if ! copy_one_table_constraints; then
			echo 1 >$CANCEL_FILE
			break
		fi
		#remove table from list
		remove_line_from_file "#$TABLE" $TABLE_LIST_FILE
		TABLE=`get_next_table`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

function th_copy_table_data()
{
	local FIRST=1
	local L_TABLE=`get_next_table`
	local CANCEL=`cat $CANCEL_FILE`
	while [ -n "$L_TABLE" -a $CANCEL -eq 0 ]; do
		#for the first table, sleep between 101ms and 1s, to avoid deadlock
		if [ $FIRST -eq 1 ]; then
			FIRST=0
			local MSEC=$((RANDOM%900+101))
			local SEC=`echo scale=3\;$MSEC/1000 | bc`
			sleep $SEC
		fi
		local INTERVAL=`echo $L_TABLE | cut -d : -f 2`
		if [ "$INTERVAL" != "$L_TABLE" ]; then
			if ! copy_one_table_interval $L_TABLE; then
				echo 1 >$CANCEL_FILE
				break
			fi
		else
			if ! copy_one_table $L_TABLE; then
				echo 1 >$CANCEL_FILE
				break
			fi
		fi
		#remove table from list
		remove_line_from_file "#$L_TABLE" $TABLE_LIST_FILE
		L_TABLE=`get_next_table`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

function th_copy_table_indexes()
{
	local CANCEL=`cat $CANCEL_FILE`
	TABLE="`get_next_table`"
	while [ -n "$TABLE" -a $CANCEL -eq 0 ]; do
		if ! copy_one_table_indexes; then
			echo 1 >$CANCEL_FILE
			break
		fi
		#remove table from list
		remove_line_from_file "#$TABLE" $TABLE_LIST_FILE
		TABLE=`get_next_table`
		local CANCEL=`cat $CANCEL_FILE`
	done
}

function usage()
{
	echo "Usage:" 
	echo "$0 [ -A ] [ -E ] [ -R ] [ -S ] [ -T ] [ -U ] [ -V ] [ -a ] [ -b <dir> ] [ -c <file> ] [ -d <login path> ] [ -h ] [ -i <file> ] [ -k ] [ -l <size> ] [ -r ] -s <login path> [ -n <threads> ] [ -t ] [ <schema> [ <table> | @<table list file>] ]"
	echo "   -A: Activate AWS Mode. See below."
	echo "   -E: Copy events"
	echo "   -G: Copy grants"
	echo "   -R: Copy routines"
	echo "   -S: For tables, copy only table structure, no data."
	echo "   -T: Copy tables (with triggers)"
	echo "   -U: Copy only users and roles"
	echo "   -V: Copy views"
	echo "   -a: When in AWS mode, copy structure, copy all data, and then recreate virtual columns and copy triggers. Can't be used with -f."
	echo "   -b: When partitioning, use a local buffer, in directory <dir>, with PK values. This makes partitioning faster. The FS holding <dir> cannot be small."
	echo "   -c: Set config file to <file>"
	echo "       Default: /etc/my-mirror.conf"
	echo "   -d: For destination, use <login path> with destination configuration (hostname, port, username, password)."
	echo "       Default: 'client'."
	echo "   -f: When in AWS mode, finish copy: recreate virtual columns and copy triggers. Can't be used with -a."
	echo "   -h: Display help and exit"
	echo "   -i: Ignore tables listed in <file>"
	echo "   -k: Keep table structure: if destination table already exists, dont't recreate it, just copy new records."
	echo "   -l: Split tables, limiting each partition size to <size>."
	echo "	   Size can be followed by a unit (Kb, Mb, or Gb). Examples: 500k, 500m, 500g. When unit is supressed, Gb is used."
	echo "		Partition size is calculated from table statistics (average row length)."
	echo "      If environment variable MY_MIRROR_TXN_LEN_FORCE_LIMIT is set, for tables partitioned by PK, each partition will have no more than <MY_MIRROR_TXN_LEN_FORCE_LIMIT> rows, even if average row length is very small."
	echo "   -r: When in AWS mode, restart copy even if it can be resumed from a previous execution"
	echo "   -s: Use login path <login path> as source instance"
	echo "       Required."
	echo "   -n: Number of threads used in the following operations: table splitting (if transaction length limit [-l option ] is active); table data copy"
	echo "       Min: 1. Max: 20. Default: 1."
	echo "   -t: For tables, copy only triggers"
	echo "   schema: Schema to be copied"
	echo "      Default: copy all schemas"
	echo "   table: If set, only this table is copied"
	echo "   table list file: If set, only tables listed in this file are copied"
	echo "Environment:"
	echo "   The following variables can be se in environment before running my-mirror:"
	echo "      MY_ADMIN_TOOLS_MAX_RETRY_COUNT: max number of tries when an access ta a database is failing"
	echo "      MY_ADMIN_TOOLS_RETRY_INTERVAL: interval (seconds) between each try when there are failures accessing databases"
	echo "      MY_MIRROR_TXN_LEN_FORCE_LIMIT: for tables partitioned by PK, each partition will have no more than <MY_MIRROR_TXN_LEN_FORCE_LIMIT> rows, even if average row length is very small."
}

function validate_options()
{
	[ -n "$SRC" ] || { echo "Option 's' is required"; usage; return 1; }
	[ -n "$DST" ] || { echo "Option 'd' is required"; usage; return 1; }

	#partitioning local dir must exist
	if [ -n "$PART_LOCAL_DIR" ]; then
		if ! [ -d "$PART_LOCAL_DIR" ]; then
			write_out "Directory '$PART_LOCAL_DIR' not found"
			return 1
		fi
	fi

	if [ $AWS -eq 1 ]; then
		validate_options_aws $* || return 1
	fi
}

function validate_options_aws()
{
	#options -F and -a can't e used together
	if [ $COPY_ALL -eq 1 -a $FINISH_MODE -eq 1 ]; then
		echo "Options 'a' and 'F' cannot be used together"
		usage
		return 1
	fi
}

function validate_options_local()
{
	[ -n "$SRC" ] || { echo "Option 's' is required"; usage; return 1; }
	[ -n "$DST" ] || { echo "Option 'd' is required"; usage; return 1; }

	#if triggers requested, but tables not requested
	if [ $ONLY_TRIGGERS -eq 1 -a $COPY_TABLES -eq 0 ]; then
		echo "Triggers requested, but tables not requested"
		return 1
	fi

	#if no object type
	if [ $COPY_CUSTOM_TABLES -eq 0 -a $COPY_TABLES -eq 0 -a $COPY_EVENTS -eq 0 -a $COPY_GRANTS -eq 0 -a $COPY_ROUTINES -eq 0 -a $COPY_USERS -eq 0 -a $COPY_VIEWS -eq 0 ]; then
		echo "No item was requested. Use at least one of the following options: -E, -G, -R, -T, -U, -V. Or either inform a table/table list."
		return 1
	fi

	if [ $# -lt 1 -o $# -gt 2 ]; then
		usage
		return 1
	fi
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +"%d %H:%M:%S"`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	echo -e "$MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "$MSG" >>"$LOG_FILE"
	fi
	return 0
}

function write_out()
{
	MSG="$1"
	TS=`date +"%d %H:%M:%S"`
	echo -e "[$TS] $MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "[$TS] $MSG" >>"$LOG_FILE"
	fi
}

function handle_int()
{
	echo 1 >$CANCEL_FILE
}

function handle_term()
{
	echo 1 >$CANCEL_FILE
}

function users_role_exists()
{
	OUT_BUFF="`mktemp \"$WORK_DIR/my-mirror.XXXXXX\"`"
	local ROLE=$1
	local QUERY="select count(1) from mysql.user where user = '$ROLE' and authentication_string = ''"
	mysql --login-path=$DST -N -e "$QUERY" >$OUT_BUFF || { rm $OUT_BUFF; return 1; }
	local COUNT=`cat $OUT_BUFF`
	rm $OUT_BUFF
	echo $COUNT
}

trap "handle_int" INT
trap "handle_term" TERM
TERMINATING=0

if [ "$DEBUG" == "1" ]; then
	set -xv
fi
run $*
RC=$?
exit $RC
