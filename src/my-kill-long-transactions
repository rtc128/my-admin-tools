#!/bin/bash

set -e

function do_kill()
{
	QUERY="select p.id, p.user, p.host from information_schema.innodb_trx t join information_schema.processlist p on t.trx_mysql_thread_id = p.id where p.user <> 'root' and convert_tz(trx_started, 'GMT', 'Brazil/East') <= now() - interval $MIN_TIME minute"
	OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF
	RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	SIZE=`stat -c %s $OUT_BUFF`
	if [ $SIZE -eq 0 ]; then
		rm $OUT_BUFF
		return 0
	fi
	local CUR_PID=0
	while read -r LINE; do
		PID=`echo $LINE | awk '{print $1;}'`
		if [ $PID -eq $CUR_PID ]; then
			continue
		fi
		CUR_PID=$PID

		USER=`echo $LINE | awk '{print $2;}'`
		HOST=`echo $LINE | awk '{print $3;}'`

		write_out "PID: $PID, User: $USER, Host: $HOST"

		CMD="kill connection $PID"
		mysql --login-path=$LOGIN_PATH -e "$CMD" >/dev/null 2>&1
	done <$OUT_BUFF
	rm $OUT_BUFF
}

function run()
{
	WORKING_DIR=/var/lib/my-admin-tools/my-kill-long-transactions
	LOGIN_PATH=client
	VERBOSE=0
	while getopts ":hl:v" OPT; do
		case $OPT in
			h)
				usage
				return 0;;
			l)
				LOGIN_PATH=$OPTARG;;
			v)
				VERBOSE=1;;
			?)
				echo "Unknown option: $OPT"
				usage
				return 1;;
			*)
				usage
				return 1;;
		esac
	done

	shift $((OPTIND-1))
	if [ $# -ne 1 ]; then
		usage "no time specifed"
		return 1;
	fi
	MIN_TIME=$1
	LOG_DIR=/var/log/my-kill-long-transactions
	mkdir -p $LOG_DIR || return 1
	LOG_FILE=$LOG_DIR/$LOGIN_PATH.log

	do_kill || return 1
}

function usage()
{
	ERR="$1"
	echo "my-kill-long-transactions"
	echo "Tool that kills sessions that are keeping an open transaction for a long time"
	echo "Operation log is printed to /var/log/my-kill-long-transactions/<login path>.log"
	if [ -n "$ERR" ]; then
		echo "Error: $ERR" >&2
	fi
	echo "Usage: $0 [ -h ] [ -l <login path> ] [ -e <user> ] [ -v ] <duration>"
	echo "   -e: Ignore sessions from user <user>. Can be used multiple times."
	echo "   -l: use login path <login path>"
	echo "      Default: client"
	echo "   -h: Show this help"
	echo "   -v: Verbose mode - print output to stdout, beside log file"
	echo "   duration: min duration (kill transactions that are open for at least <duration> minutes)"
}

function write_file_out()
{
	local F="$1"
	SIZE=`stat -c %s "$F"`
	[ $SIZE -ne 0 ] || return 0
	local CUR_TIMESTAMP=`date +%Y-%m-%d_%T`
	local LINE="[$CUR_TIMESTAMP $$] $MSG"
	if [ $VERBOSE -eq 1 ]; then
		echo "$CUR_TIMESTAMP"
	fi
	echo "$CUR_TIMESTAMP" >>$LOG_FILE
	echo "======================================="
	echo "=======================================" >>$LOG_FILE
	if [ $VERBOSE -eq 1 ]; then
		cat "$F"
	fi
	cat "$F" >>$LOG_FILE
	echo "======================================="
	echo "=======================================" >>$LOG_FILE
}

function write_out()
{
	local MSG="$1"
	local CUR_TIMESTAMP=`date +%Y-%m-%d_%T`
	local LINE="[$CUR_TIMESTAMP $$] $MSG"
	if [ $VERBOSE -eq 1 ]; then
		echo "$LINE"
	fi
	echo "$LINE" >>"$LOG_FILE"
}

run $*
RC=$?
exit $RC
