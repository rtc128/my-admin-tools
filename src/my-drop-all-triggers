#!/bin/bash

function usage()
{
	echo "my-admin-tools: my-drop-triggers - drop all triggers in a schema"
	echo "Usage: $0 [ -l <path> ] <schema>"
	echo "   -l: use login path <path>"
	echo "      Default: 'client'"
	echo "Credentials must be saved using 'mysql_config_editor'"
}

function run()
{
	LOGIN_PATH=client
	while getopts "l:" opt; do
		case $opt in
			l)
				LOGIN_PATH=$OPTARG;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))
	if [ $# -ne 1 ]; then
		usage
		return 1
	fi
	SCHEMA=$1

	QUERY="select trigger_name from information_schema.triggers where trigger_schema = '$SCHEMA'"
	BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" >$BUFF || return 1
	sed -i -e "s/\(.*\)/drop trigger $SCHEMA\.\1\;/" $BUFF
	mysql --login-path=$LOGIN_PATH <$BUFF || return 1
	rm $BUFF
}

run $*
RC=$?
exit $RC
