#!/bin/bash

BLOCK_LENGTH=50000
SECONDS_BEHIND=15
MAX_RETRY_COUNT=3
RETRY_INTERVAL=10
COMPARE_DAYS_BEHIND=180

if [ "$DEBUG" == "1" ]; then
   set -x
fi

function count_columns()
{
	local QUERY="select
			count(1)
		from
			information_schema.columns
		where
			table_schema = '$SCHEMA' and
			lower(column_type) in ('date', 'datetime', 'timestamp')"

	write_out "Counting timestamp columns"
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$SRC -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF || return 1
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	COL_COUNT=`cat $OUT_BUFF`
	rm $OUT_BUFF
	return 0
}

function do_validation()
{
	local UNIX_NOW=`date +%s`
	local UNIX_MIN_TIME=$((UNIX_NOW-$COMPARE_DAYS_BEHIND))
	MIN_TIME="`date -d @$UNIX_MIN_TIME +\"%Y-%m-%d %H:%M:%S\"`"
	local UNIX_MAX_TIME=$((UNIX_NOW-$SECONDS_BEHIND))
	MAX_TIME="`date -d @$UNIX_MAX_TIME +\"%Y-%m-%d %H:%M:%S\"`"

	DATA_DIR="/tmp/my-val-mirror"
	mkdir -p "$DATA_DIR" || return 1
	rm -fr "$DATA_DIR/"* || return 1

	#for each table, create a thread
	while read -r LINE; do
		local TABLE="`echo $LINE | cut -d : -f 1`"
		local COLUMN="`echo $LINE | cut -d : -f 2`"
		validate_th "$TABLE" "$COLUMN" &
	done <$LIST_FILE
	wait
}

function mount_log_path()
{
	local DT=`date +%Y-%m-%d`
	local TS=`date +%T`
	local LOG_DIR=/var/log/my-admin-tools/my-val-mirror/$DT
	mkdir -p $LOG_DIR || return 1
	local LOG_BN=${TS}.log
	echo $LOG_DIR/$LOG_BN
}

function print_options()
{
	if [ -n "$SRC" ]; then
		write_out "Source login path: $SRC"
	fi
	if [ -n "$DST" ]; then
		write_out "Destination login path: $DST"
	fi
	write_out "Schema: $SCHEMA"
	write_out "List file: $LIST_FILE"
}

function run()
{
	CANCEL=0
	SCHEMA=
	DST=client

	local opt

	while getopts "d:s:" opt; do
		case $opt in
			d)
				DST=$OPTARG;;
			s)
				SRC=$OPTARG;;
			*)
				echo "Unknown option '$opt'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))

	if [ $# -ne 2 ]; then
		usage
		return 1
	fi
	SCHEMA="$1"
	LIST_FILE="$2"

	validate_options $* || return 1

	local TMP_LOG_FILE=`mount_log_path` || return 1
	write_out "Log file: $TMP_LOG_FILE"
	LOG_FILE="$TMP_LOG_FILE"
	print_options || return 1

	CANCEL_FILE=`mktemp /tmp/my-admin-tools.XXXXXX`
	echo 0 >$CANCEL_FILE
	do_validation
	local CANCEL=`cat $CANCEL_FILE`
	rm $CANCEL_FILE
	if [ $CANCEL -eq 0 ]; then
		write_out "Validation finished successfully"
	else
		write_out "Validation cancelled"
	fi
	return $CANCEL
}

function remove_line_from_file()
{
	local LINE="$1"
	local FPATH="$2"
	{
		flock 3
		sed -i -e "/^$LINE$/d" $FPATH
	} 3<$LOCK_FILE
}

function get_primary_key()
{
	local TABLE="$1"
	local OUT_FILE="$2"

	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local QUERY="select column_name from information_schema.columns where table_schema = '$SCHEMA' and table_name = $TABLE and column_key = 'PRI' and ordinal_position = 1"
	mysql --login-path=$SRC -N -e "$QUERY" >"$OUT_FILE" 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || return 1
}

function usage()
{
	echo "Usage:" 
	echo "$0 [ -d <path> ] -s <path> <schema> <file>"
	echo "   -d: For destination, use <path> with destination configuration (hostname, port, username, password)."
	echo "       Default: 'client'."
	echo "   -s: Use login path <path> as source instance"
	echo "   schema: Schema to be validated"
	echo "   file: table list file"
	echo "      a file with one table per line"
	echo "      format: <table>:<column>"
	echo "         column: must be a timestamp column, filled with the moment of each row creation"
}

function validate_options()
{
	[ -n "$SRC" ] || { echo "Option 's' is required"; usage; return 1; }
#list file must exists
	if ! [ -f "$LIST_FILE" ]; then
		echo "Cannot find file '$LIST_FILE'" >&2
		return 1
	fi
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +"%d %H:%M:%S"`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	echo -e "$MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "$MSG" >>"$LOG_FILE"
	fi
	return 0
}

function write_out()
{
	MSG="$1"
	TS=`date +"%d %H:%M:%S"`
	echo -e "[$TS] $MSG"
	if [ -n "$LOG_FILE" ]; then
		echo -e "[$TS] $MSG" >>"$LOG_FILE"
	fi
}

function handle_int()
{
	CANCEL=1
}

function handle_term()
{
	CANCEL=1
}

function validate_th()
{
	local TABLE="$1"
	local COLUMN="$2"

	local PK_FILE=`mktemp /tmp/my-admin-tools.XXXXXX`
	get_primary_key \"$TABLE\" $PK_FILE || { write_out "Can't find PK for table '$TABLE'"; rm $PK_FILE; echo 1 >$CANCEL_FILE; return; }
	local PK=`cat $PK_FILE`
	rm $PK_FILE
	[ -n "$PK" ] || { write_out "Can't find PK for table '$TABLE'"; echo 1 >$CANCEL_FILE; return; }

	local SRC_DATA="$DATA_DIR/$TABLE.src.log"
	local DST_DATA="$DATA_DIR/$TABLE.dst.log"

	local QUERY
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local START_ROW=1

	local CANCEL=`cat $CANCEL_FILE`
	while [ $CANCEL -eq 0 ]; do
		QUERY="select * from \`$TABLE\` where \`$COLUMN\` between '$MIN_TIME' and '$MAX_TIME' order by \`$PK\` limit $START_ROW, $BLOCK_LENGTH"

		write_out "Comparing table '$TABLE' [rows $START_ROW >> +$BLOCK_LENGTH]"
		mysql --login-path=$SRC -e "$QUERY" $SCHEMA >"$SRC_DATA" 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		[ $RC -eq 0 ] || { write_out "Error reading table '$TABLE' from source instance"; echo 1 >$CANCEL_FILE; break; }

		local RSET_COUNT=`cat "$SRC_DATA" | wc -l`
		[ $RSET_COUNT -gt 0 ] || break

		mysql --login-path=$DST -e "$QUERY" $SCHEMA >$DST_DATA 2>$ERR_BUFF
		local RC=$?
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
		[ $RC -eq 0 ] || { write_out "Error reading table '$TABLE' from destination instance"; echo 1 >$CANCEL_FILE; break; }

		local SRC_MD5=`md5sum "$SRC_DATA" | awk '{print $1;}'`
		local DST_MD5=`md5sum "$DST_DATA" | awk '{print $1;}'`
		CANCEL=`cat $CANCEL_FILE`
		if [ $CANCEL -eq 0 -a "$SRC_MD5" != "$DST_MD5" ]; then
			write_out "*** FOUND A DIFFERENCE: table '$TABLE' - $DATA_DIR"
			echo 1 >$CANCEL_FILE
			break
		fi
		START_ROW=$((START_ROW+BLOCK_LENGTH))
	done
}

trap "handle_int" INT
trap "handle_term" TERM
TERMINATING=0

if [ "$DEBUG" == "1" ]; then
	set -xv
fi
run $*
RC=$?
exit $RC
