#!/bin/bash

set -e

CONNECT_TIMEOUT=3

function kill_row_blockers()
{
	local USER_FILTER="p.user <> 'root' and"
	if [ $ALL_USERS -eq 1 ]; then
		USER_FILTER=
	fi
	QUERY="select
			w1.blocking_pid as pid,
			p.user,
			p.host,
			concat(w1.locked_table_schema, '.', w1.locked_table_name) as locked_table_name
		from
			sys.innodb_lock_waits w1
			join information_schema.processlist p on w1.blocking_pid = p.id
		where
			$USER_FILTER
			w1.wait_age_secs + 10800 >= $MIN_TIME and
			not exists (select 1 from sys.innodb_lock_waits w2 where w2.waiting_pid = w1.blocking_pid)
		order by
			w1.blocking_pid"
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH --connect-timeout=$CONNECT_TIMEOUT -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	local SIZE=`stat -c %s $OUT_BUFF`
	if [ $SIZE -eq 0 ]; then
		rm $OUT_BUFF
		return 0
	fi
	local CUR_PID=0
	while read -r LINE; do
		local PID=`echo $LINE | awk '{print $1;}'`
		if [ $PID -eq $CUR_PID ]; then
			continue
		fi
		local CUR_PID=$PID

		local USER=`echo $LINE | awk '{print $2;}'`
		local HOST=`echo $LINE | awk '{print $3;}'`
		local TABLE_NAME=`echo $LINE | awk '{print $4;}'`

		write_out "PID: $PID, User: $USER, Host: $HOST, Table: $TABLE_NAME [ROW LOCK]"

		ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
		local CMD="kill connection $PID"
		if [ $AWS_MODE -eq ]; then
			CMD="call mysql.rds_kill($PID)"
		fi

		mysql --login-path=$LOGIN_PATH --connect-timeout=$CONNECT_TIMEOUT -e "$CMD" 2>$ERR_BUFF
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
	done <$OUT_BUFF
	rm $OUT_BUFF
}

function kill_metadata_blockers()
{
	local USER_FILTER="p.user <> 'root' and"
	if [ $ALL_USERS -eq 1 ]; then
		USER_FILTER=
	fi
	QUERY="select
			w1.blocking_pid,
			p.user,
			p.host,
			w1.object_name
		from
			sys.schema_table_lock_waits w1
			join information_schema.processlist p on w1.blocking_pid = p.id
		where
			$USER_FILTER
			w1.waiting_query_secs >= $MIN_TIME and
			not exists (select 1 from sys.schema_table_lock_waits w2 where w2.waiting_pid = w1.blocking_pid)
		order by
			w1.blocking_pid"
	local OUT_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	mysql --login-path=$LOGIN_PATH --connect-timeout=$CONNECT_TIMEOUT -N -e "$QUERY" >$OUT_BUFF 2>$ERR_BUFF
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || { rm $OUT_BUFF; return 1; }
	SIZE=`stat -c %s $OUT_BUFF`
	if [ $SIZE -eq 0 ]; then
		rm $OUT_BUFF
		return 0
	fi
	local CUR_PID=0
	while read -r LINE; do
		local PID=`echo $LINE | awk '{print $1;}'`
		if [ $PID -eq $CUR_PID ]; then
			continue
		fi
		local CUR_PID=$PID

		local USER=`echo $LINE | awk '{print $2;}'`
		local HOST=`echo $LINE | awk '{print $3;}'`
		local TABLE_NAME=`echo $LINE | awk '{print $4;}'`
		write_out "PID: $PID, User: $USER, Host: $HOST, Object: $TABLE_NAME [SCHEMA TABLE LOCK]"
		ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
		local CMD="kill connection $PID"
		if [ $AWS_MODE -eq ]; then
			local CMD="call mysql.rds_kill($PID)"
		fi
		mysql --login-path=$LOGIN_PATH --connect-timeout=$CONNECT_TIMEOUT -e "$CMD" 2>$ERR_BUFF
		write_file_out $ERR_BUFF
		rm $ERR_BUFF
	done <$OUT_BUFF
	rm $OUT_BUFF
}

function run()
{
	ALL_USERS=0
	AWS_MODE=0
	WORKING_DIR=/var/lib/my-admin-tools/my-kill-blockers
	EXEC_COUNT=1
	INTERVAL=60
	LOGIN_PATH=client
	METADATA=1
	MIN_SESSIONS=0
	ONLY_METADATA=0
	ONLY_ROW=0
	ROW=1
	VERBOSE=0

	while getopts ":Aahi:l:mn:rs:v" OPT; do
		case $OPT in
			A)
				AWS_MODE=1;;
			a)
				ALL_USERS=1;;
			h)
				usage
				return 0;;
			i)
				INTERVAL=$OPTARG;;
			l)
				LOGIN_PATH=$OPTARG;;
			m)
				ONLY_METADATA=1
				ROW=0;;
			n)
				EXEC_COUNT=$OPTARG;;
			r)
				ONLY_ROW=1
				METADATA=0;;
			s)
				MIN_SESSIONS=$OPTARG;;
			v)
				VERBOSE=1;;
			?)
				echo "Unknown option: $OPT"
				usage
				return 1;;
			*)
				usage
				return 1;;
		esac
	done

	shift $((OPTIND-1))
	if [ $# -ne 1 ]; then
		usage "no time specifed"
		return 1;
	fi
	MIN_TIME=$1

	validate_params || return 1

	LOG_DIR=/var/log/my-admin-tools/my-kill-blockers
	mkdir -p $LOG_DIR || return 1
	LOG_FILE=$LOG_DIR/$LOGIN_PATH.log

	mkdir -p "$WORKING_DIR" || return 1
	LOCK_FILE_BASENAME=.$LOGIN_PATH.lock

	#first, if asked, kill metadata blockers, only once
	[ $METADATA -ne 1 ] || kill_metadata_blockers

	[ $ROW -eq 1 ] || return 0

	local NOW=`date +%s`
	local LIMIT_TIME=$((NOW+EXEC_COUNT*INTERVAL))
	for I in `seq 1 $EXEC_COUNT`; do
		#check if there's enough time to run once again
		NOW=`date +%s`
		if [ $I -gt 1 -a $((NOW+INTERVAL)) -ge $LIMIT_TIME ]; then
			break
		fi

		[ $I -eq 1 ] || sleep $INTERVAL

		#if filtered for session count, check locks only if session count is beyond limit
		if [ $MIN_SESSIONS -gt 0 ]; then
			local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
			local COUNT=`mysql --login-path=$LOGIN_PATH --connect-timeout=$CONNECT_TIMEOUT -N -e "show status like 'threads_running'" 2>$ERR_BUFF | awk '{ print $2; }'`
			write_file_out $ERR_BUFF
			rm $ERR_BUFF
			if [ -z "$COUNT" ]; then
				continue
			fi
			if [ $COUNT -lt $MIN_SESSIONS ]; then
				continue
			fi
		fi

		kill_row_blockers || return 1
	done
}

function validate_params()
{
	if [ $INTERVAL -lt 5 ]; then
		echo "=== <interval> must be 5 or greater ===" >&2
		echo
		return 1
	fi
	if [ $INTERVAL -gt 600 ]; then
		echo "=== <interval> must be 600 or lower ===" >&2
		echo
		return 1
	fi

	#count
	if [ $EXEC_COUNT -lt 1 ]; then
		echo "=== <interval> must be 1 or greater ===" >&2
		echo
		return 1
	fi
	if [ $EXEC_COUNT -gt 200 ]; then
		echo "<interval> must be 200 or lower" >&2
		return 1
	fi

	#options for only metadata and for only row locks can't be set together
	if [ $ONLY_METADATA -eq 1 -a $ONLY_ROW -eq 1 ]; then
		echo "=== Options -m and -r can't be used together. If you wish to search for both row and metadata locks, please remove both options. ===" >&2
		echo
		usage
		return 1
	fi
}

function usage()
{
	ERR="$1"
	echo "=== my-admin-tools ==="
	echo "my-kill-blockers - Tool to kill sessions that are blocking other sessions."
	echo "By default, both types of lock are searched: row and metadata."
	echo "Operation log is printed to /var/log/my-kill-blockers/<login path>.log"
	if [ -n "$ERR" ]; then
		echo "Error: $ERR" >&2
	fi
	echo "Usage: $0 [ -A ] [ -a ] [ -h ] [ -i <interval> ] [ -l <login path> ] [ -m ] [ -n <count> ] [ -s <count> [ -v ] <time>"
	echo "   -A: Use commands that are compatible with AWS RDS and uncompatible with official MySQL"
	echo "   -a: Do not ignore blocking sessions opened by root"
	echo "   -h: Show this help"
	echo "   -i: Set the interval between executions to <interval> seconds."
	echo "      Default: 60"
	echo "      Min: 5"
	echo "      Max: 600"
	echo "   -l: use login path <login path>"
	echo "      Default: client"
	echo "   -m: Only search for table metadata locks"
	echo "      Can't be used with -r"
	echo "   -n: Set the number of executions to <count>."
	echo "      Default: 1"
	echo "      Min: 1"
	echo "      Max: 200"
	echo "   -r: Only search for row locks"
	echo "      Can't be used with -m"
	echo "   -s: Search for locks only if there are at least <count> active sessions"
	echo "   -v: Verbose mode - print output to stdout, beside log file"
	echo "   time: min wait time (kill only if there's a session waiting for <time> or more seconds)"
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +%Y-%m-%d_%T`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	if [ $VERBOSE -eq 1 ]; then
		echo -e "$MSG"
	fi
	if [ -n "$LOG_FILE" ]; then
		echo -e "$MSG" >>"$LOG_FILE"
	fi
	return 0
}

function write_out()
{
	local MSG="$1"
	local CUR_TIMESTAMP=`date +%Y-%m-%d_%T`
	local LINE="[$CUR_TIMESTAMP $$] $MSG"
	if [ $VERBOSE -eq 1 ]; then
		echo "$LINE"
	fi
	echo "$LINE" >>"$LOG_FILE"
}

run $*
RC=$?
exit $RC
