#!/bin/bash

function compare_rows()
{
	echo 0 >$CANCEL_FILE
	local COUNT_FILE_1=`mktemp /tmp/my-admin-tools.XXXXXX`
	local COUNT_FILE_2=`mktemp /tmp/my-admin-tools.XXXXXX`

	write_out "         Comparing row count"
	LOGIN_PATH=$LPATH1
	RESULT_FILE=$COUNT_FILE_1
	th_count &

	LOGIN_PATH=$LPATH2
	RESULT_FILE=$COUNT_FILE_2
	th_count &

	wait

	local CANC=`cat $CANCEL_FILE`
	if [ $CANC -eq 1 ]; then
		rm $COUNT_FILE_1 $COUNT_FILE_2
		return 1
	fi

	local COUNT1=`cat $COUNT_FILE_1`
	local COUNT2=`cat $COUNT_FILE_2`
	rm $COUNT_FILE_1 $COUNT_FILE_2
	write_out "            $LPATH1: $COUNT1"
	write_out "            $LPATH2: $COUNT2"
	if [ $COUNT1 -ne $COUNT2 ]; then
		write_out "Difference found - row count"
	fi
}

function compare_struct()
{
	write_out "         Comparing table structure"
	local STRUCT1=`mktemp /tmp/my-admin-tools.XXXXXX`
	local STRUCT2=`mktemp /tmp/my-admin-tools.XXXXXX`
	local QUERY="show create table \`$TABLE\`"
	write_out "            $LPATH1"
	mysql --login-path=$LPATH1 -N -e "$QUERY" $SCHEMA >$STRUCT1 || { rm $STRUCT1 $STRUCT 2; return 1; }
	write_out "            $LPATH2"
	mysql --login-path=$LPATH2 -N -e "$QUERY" $SCHEMA >$STRUCT2 || { rm $STRUCT1 $STRUCT 2; return 1; }
	if ! diff $STRUCT1 $STRUCT2; then
		write_out "Difference found - table structure"
	fi
	rm $STRUCT1 $STRUCT2
}

function th_count()
{
	local ERR_BUFF=`mktemp /tmp/my-admin-tools.XXXXXX`
	local QUERY="select count(1) from $TABLE"
	mysql --login-path=$LOGIN_PATH -N -e "$QUERY" $SCHEMA >"$RESULT_FILE" 2>"$ERR_BUFF"
	local RC=$?
	write_file_out $ERR_BUFF
	rm $ERR_BUFF
	[ $RC -eq 0 ] || echo 1 >$CANCEL_FILE
}


function usage()
{
	echo "my-db-compare: Compare structure and table lengths between 2 instances"
	echo "Usage: $0 [ -r ] [ -s ] <login path 1> <login path 2>"
	echo "   -r: compare row count for each table"
	echo "   -s: compare structure for each table"
}

function run()
{
	CMP_ROWS=0
	CMP_ROWS=0

	while getopts "rs" OPT; do
		case $OPT in
			r)
				CMP_ROWS=1;;
			s)
				CMP_STRUCT=1;;
			*)
				echo "Unknown option '$OPT'" >&2
				usage
				return 1;;
		esac
	done
	shift $((OPTIND-1))

	if [ $# -ne 2 ]; then
		usage
		return 1
	fi

	LPATH1=$1
	LPATH2=$2

	DIFF_COUNT=0
	write_out "Listing schemas"
	QUERY="select schema_name from information_schema.schemata where schema_name not in ('sys', 'information_schema', 'performance_schema', 'mysql') order by 1"
	SCHEMAS=`mysql --login-path=$LPATH1 -N -e "$QUERY"` || return 1

	CANCEL_FILE=`mktemp /tmp/my-admin-tools.XXXXXX`
	echo 0 >$CANCEL_FILE
	for SCHEMA in $SCHEMAS; do
		write_out "   Entering schema '$SCHEMA'"
		write_out "   Listing tables"

		QUERY="select table_name from information_schema.tables where table_schema = '$SCHEMA' and table_type = 'BASE TABLE'"
		TABLES=`mysql --login-path=$LPATH1 -N -e "$QUERY"` || { rm $CANCEL_FILE; return 1; }

		for TABLE in $TABLES; do
			write_out "      Comparing table '$TABLE'"
			if [ $CMP_ROWS -eq 1 ]; then
				compare_rows || { rm $CANCEL_FILE; return 1; }
			fi
			if [ $CMP_STRUCT -eq 1 ]; then
				compare_struct || { rm $CANCEL_FILE; return 1; }
			fi
		done
	done
	rm $CANCEL_FILE
}

function write_file_out()
{
	local OUT_F="$1"
	local SIZE=`stat -c %s "$OUT_F"`
	if [ $SIZE -eq 0 ]; then
		return 0
	fi
	local TS=`date +"%d %H:%M:%S"`
	local MSG="[$TS]\n`cat \"$OUT_F\" | sed -e 's/^/\t/'`"
	echo -e "$MSG"
}

function write_out()
{
	MSG="$1"
	TS=`date +"%d %H:%M:%S"`
	echo -e "[$TS] $MSG"
}

run $*
RC=$?
exit $RC
